// Prisma schema — داشبورد هوشمند چندعامله ملک تبریز
// Owner/Designer/Developer: سید نعمت اله سیدی

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===================== امنیت و احراز هویت =====================

/// نشست‌های کاربری — توکن به‌صورت هش‌شده ذخیره می‌شود (هرگز متن ساده)
/// توکن‌های ARM (دریافت‌شده از سامانه واقعی ملک تبریز) رمزنگاری‌شده AES-256-GCM نگهداری می‌شوند
model Session {
  id                 String    @id @default(cuid())
  tokenHash          String    @unique
  personnelCode      String
  displayName        String
  role               String    @default("CONSULTANT") // OWNER | CONSULTANT
  /// توکن دسترسی ARM — رمزنگاری‌شده (اختیاری؛ ورود مدیر محلی ندارد)
  armTokenEnc        String?
  /// توکن تمدید ARM — رمزنگاری‌شده
  armRefreshTokenEnc String?
  /// نوع کاربر در سامانه ARM (مثلاً realtor)
  armUserType        String?
  createdAt          DateTime  @default(now())
  expiresAt          DateTime
  lastSeenAt         DateTime  @default(now())
  revoked            Boolean   @default(false)
  revokedReason      String?
  userAgent          String?
  ip                 String?
  /// P6.5-02 (ConsultantScope §۵.۱) — شعبه کاربر (از PM/businesses) — افزودنی
  branchId           String?
  /// P6.5-02 (ConsultantScope §۵.۱) — دامنه دسترسی داده: OWNER | BRANCH | CONSULTANT
  /// default امن: نشست‌های موجود و ورود مدیر = OWNER (رفتار فعلی صفر-تغییر)
  accessScope        String    @default("OWNER")
  /// P6545/گام۱ (BLOCK 1.3) — آرشیو دادهٔ مرده: صفر حذف؛ فقط برچسب (قانون دادهٔ مقدس)
  archivedAt         DateTime?
}

/// ثبت تلاش‌های احراز هویت برای محدودسازی نرخ (Rate Limiting)
model OtpAttempt {
  id            String   @id @default(cuid())
  personnelCode String
  kind          String // REQUEST_OTP | VERIFY_OTP | MASTER_LOGIN
  success       Boolean  @default(false)
  createdAt     DateTime @default(now())
  ip            String?

  @@index([personnelCode, kind, createdAt])
}

/// رد حسابرسی امنیتی — P6.5-02: پسوندهای حسابرسی دسترسی (§۶ طراحی) افزودنی شد؛
/// action حفظ شد (سازگاری v1)؛ operation تمایز خواندن/نوشتن را صریح می‌کند.
model AuditLog {
  id          String   @id @default(cuid())
  action      String
  actor       String?
  detail      String?
  createdAt   DateTime @default(now())
  /// P6.5-02 (§۶.۱) — نوع عملیات: READ | WRITE | DELETE
  operation   String?
  /// P6.5-02 (§۶.۱) — موجودیت درگیر: transaction | customer | listing | request | visit | contract | property
  entityType  String?
  /// P6.5-02 (§۶.۱) — تعداد رکوردهای درگیر این دسترسی
  recordCount Int?
  /// P6.5-02 (§۶.۱) — دامنه دسترسی لحظه عملیات: OWNER | BRANCH | CONSULTANT
  accessScope String?
  /// P6.5-02 (§۱۱/§۱۴) — آماده‌سازی چند-مستأجری (منطق فعال در PHASE 8+)
  tenantId    String   @default("melk-tabriz")

  @@index([createdAt])
}

// ===================== داده‌های CRM (کش/همگام‌سازی) =====================

/// وضعیت همگام‌سازی با سامانه‌های واقعی ملک تبریز (تک‌رکورد — فقط متادیتا)
/// HOTFIX-02 (SEC-3): ستون armTokenEnc حذف شد — توکن ARM فقط per-user در Session
/// نگهداری می‌شود؛ این جدول دیگر هیچ رازی ذخیره نمی‌کند.
model SyncState {
  id                   String    @id // "singleton"
  lastSyncedAt         DateTime?
  lastSuccessAt        DateTime?
  lastError            String?
  lastErrorCode        String?
  attempts             Int       @default(0)
  /// خلاصه چهارگانه گزارش تطابق سامانه ARM (JSON)
  summaryJson          String?
  /// P2-04 — نقطهٔ ازسرگیری: خانواده‌های تکمیل‌شدهٔ آخرین اجرا (JSON {runId, families})
  lastSyncCursor       String?
  /// P2-04 — علامت آب: زمان آخرین دادهٔ تازهٔ دیده‌شده از سامانه ARM
  lastWatermark        DateTime?
  /// P2-04 — شناسه اجرای جاری (idempotency — upsertها با کلید طبیعی بی‌اثر از نو اجرا می‌شوند)
  syncRunId            String?
  /// P6.5-03 (§۱.۵) — checkpoint یکپارچه Bulk Import (JSON)؛ جدا از فیلدهای sync منظم
  bulkImportCheckpoint String?
  updatedAt            DateTime  @updatedAt
}

/// P2-04 — نامهٔ مردهٔ همگام‌سازی: ردیفی که ۳ بار پیاپی ناموفق مانده است.
/// ردیف باز (resolvedAt=null) از مسیر افزایشی حذف نمی‌شود تا اپراتور بررسی کند؛
/// با موفقیت بعدی resolvedAt پر می‌شود.
model SyncDeadLetter {
  id            String    @id @default(cuid())
  /// شناسه اجرای همگام‌سازی که در آن شکست رخ داد
  runId         String
  /// خانواده موجودیت: transactions | experts | interactions | visits | supplyDemand | contracts
  entity        String
  /// کلید طبیعی ردیف (id / personnelCode)
  naturalKey    String
  /// تعداد تلاش‌های ناموفق پیاپی
  attempts      Int       @default(1)
  /// آخرین خطا (کوتاه — ۳۰۰ نویسه)
  lastError     String?
  lastAttemptAt DateTime  @default(now())
  /// زمان حل — null = باز
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@unique([entity, naturalKey])
  @@index([entity])
  @@index([runId])
}

/// معاملات (گزارش تطابق معاملات) — عین ساختار خود سامانه ARM:
/// هر معامله = تطبیق آگهی ملک با درخواست خرید + اطلاعات قرارداد
model TransactionRecord {
  id                     String   @id
  /// تاریخ معامله/قرارداد — از contractDate سامانه (ISO داخلی)
  contractDate           DateTime
  /// کد ملک (آگهی فروشنده)
  propertyCode           String
  /// نام مالک/مشتریِ طرف ملک
  propertyCustomer       String?
  /// کد درخواست خرید (اگر از مسیر درخواست رسیده باشد)
  requestCode            String?
  /// نام درخواست‌دهنده طرف درخواست
  requestCustomer        String?
  /// شماره هولوگرام قرارداد (شناسه رسمی سند)
  contractHolo           String?
  /// تعداد آگهی‌های پیشنهادی سیستم برای این تطبیق
  suggestedPropertyCount Int      @default(0)
  /// تعداد رویدادهای ثبت‌شده (تعامل کارشناس با درخواست)
  eventsCount            Int      @default(0)
  syncedAt               DateTime @default(now())

  /// P6.5-02 (§۵.۳) — کد کارشناس صاحب رکورد (انتساب Scope؛ در ماتریس فعلی تجمیعی)
  ownerCode   String?
  /// P6.5-02 (§۵.۳) — شعبه انتساب Scope
  branchId    String?
  /// P6.5-02 (§۱۴ مصوبه شورا) — آماده‌سازی چند-مستأجری — nullable + default، بدون منطق فعال
  tenantId    String? @default("melk-tabriz")
  /// P6.5-03 — شناسه آخرین اجرای Bulk که این رکورد را نوشت (محافظت از جاروی sync — §۱.۹)
  sourceRunId String?

  /// P6.5-04-e-v2 — لایه ۱ حقیقت: تاریخ خام عین منبع (پیش از تبدیل جلالی؛ هرگز توسط نرمال‌سازی تغییر نمی‌کند)
  rawDate              String?
  /// B.3 (P6.5-04-v2) — لایه ۱ حقیقت: نام خام طرف ملک عین منبع (پیش از normalizeName)
  rawPropertyCustomer  String?
  /// B.3 (P6.5-04-v2) — لایه ۱ حقیقت: نام خام طرف درخواست عین منبع
  rawRequestCustomer   String?
  /// P6.5-04-e-v2 — نسخه داده منبع (ARM فعلاً نسخه منتشر نمی‌کند — تهی تا کشف در Reconnaissance)
  rawSourceVersion     String?
  /// P6.5-04-e-v2 — زمان استخراج (شروع اجرای bulk که این ردیف را نوشت)
  extractedAt          DateTime?
  /// P6.5-04-e-v2 — شناسه دسته استخراج (= runId اجرای bulk)
  extractionBatchId    String?
  /// P6.5-04-e-v2 — نسخه موتور نرمال‌سازی که مقادیر نرمال‌شده را نوشت
  normalizationVersion String?

  @@index([contractDate])
  @@index([propertyCode])
  @@index([requestCode])
}

/// کارشناسان (realtors/list) — عین ساختار users-list خود سامانه ARM
model ExpertRecord {
  id            String   @id
  personnelCode String   @unique
  fullName      String
  mobile        String
  /// نقش کاربر (مثلاً «کارشناس و مشاور فروش»)
  role          String
  /// عنوان کسب‌وکار/شعبه
  businessTitle String
  /// نام ثبت‌کننده (مدیری که کاربر را ایجاد کرده)
  creator       String?
  active        Boolean  @default(true)
  /// تاریخ ثبت/عضویت
  createdAt     DateTime
  syncedAt      DateTime @default(now())

  /// P6.5-02 (§۵.۳) — شعبه انتساب Scope (از PM/businesses)
  branchId             String?
  /// P6.5-02 (§۱۴ مصوبه شورا) — آماده‌سازی چند-مستأجری — nullable + default، بدون منطق فعال
  tenantId             String?   @default("melk-tabriz")
  /// P6.5-03 — شناسه آخرین اجرای Bulk که این رکورد را نوشت (محافظت از جاروی sync — §۱.۹)
  sourceRunId          String?
  /// B.3 (P6.5-04-v2) — لایه ۱ حقیقت: نام/موبایل/کسب‌وکار/ثبت‌کننده خام عین منبع
  rawFullName          String?
  rawMobile            String?
  rawBusinessTitle     String?
  rawCreator           String?
  /// P6.5-04-e-v2 — ستون‌های سه‌لایه حقیقت (provenance؛ ARM فعلاً نسخه منتشر نمی‌کند)
  rawSourceVersion     String?
  extractedAt          DateTime?
  extractionBatchId    String?
  normalizationVersion String?

  @@index([fullName])
  @@index([role])
  @@index([businessTitle])
}

/// تعاملات مشاوران با یکدیگر — عین ساختار realtor-interactions سامانه ARM:
/// مشاور درخواست × مشاور آگهی × تعداد همکاری‌های منجر به تطبیق
model InteractionRecord {
  id                     String    @id
  requestRealtorName     String
  propertyRealtorName    String
  count                  Int       @default(0)
  syncedAt               DateTime  @default(now())
  /// P6.5-03 — شناسه آخرین اجرای Bulk که این رکورد را نوشت (محافظت از جاروی sync — §۱.۹)
  sourceRunId            String?
  /// B.3 (P6.5-04-v2) — لایه ۱ حقیقت: نام‌های خام عین منبع (کلید طبیعی این جدول)
  rawRequestRealtorName  String?
  rawPropertyRealtorName String?
  /// P6.5-04-e-v2 — ستون‌های سه‌لایه حقیقت (provenance؛ ARM فعلاً نسخه منتشر نمی‌کند)
  rawSourceVersion       String?
  extractedAt            DateTime?
  extractionBatchId      String?
  normalizationVersion   String?

  @@index([requestRealtorName])
  @@index([propertyRealtorName])
}

/// بازدیدها و پیگیری‌ها — عین ساختار visits/list سامانه ARM:
/// بررسی‌کننده × درخواست‌دهنده × کد آگهی × زمان ثبت/بررسی
model VisitRecord {
  id                  String    @id
  /// کد آگهی مرتبط
  propertyCode        String
  /// نام درخواست‌دهنده (مشتری)
  requesterName       String
  /// نام بررسی‌کننده (کارشناس/مدیر)
  checkerName         String
  /// نام مشاور آگهی
  propertyRealtorName String
  /// زمان بررسی (ISO — خالی اگر بررسی نشده باشد)
  checkTime           DateTime?
  /// زمان ثبت بازدید
  createdAt           DateTime
  /// وضعیت بازدید (رشته فارسی سامانه)
  status              String    @default("")
  syncedAt            DateTime  @default(now())

  /// P6.5-02 (§۵.۳) — کد کارشناس بررسی‌کننده (انتساب Scope از checker؛ fail-closed: تهی = فقط OWNER)
  ownerCode              String?
  /// P6.5-02 (§۵.۳) — شعبه انتساب Scope
  branchId               String?
  /// P6.5-02 (§۱۴ مصوبه شورا) — آماده‌سازی چند-مستأجری — nullable + default، بدون منطق فعال
  tenantId               String?   @default("melk-tabriz")
  /// P6.5-03 — شناسه آخرین اجرای Bulk که این رکورد را نوشت (محافظت از جاروی sync — §۱.۹)
  sourceRunId            String?
  /// B.3 (P6.5-04-v2) — لایه ۱ حقیقت: نام‌های خام عین منبع
  rawRequesterName       String?
  rawCheckerName         String?
  rawPropertyRealtorName String?
  /// P6.5-04-e-v2 — ستون‌های سه‌لایه حقیقت (provenance؛ ARM فعلاً نسخه منتشر نمی‌کند)
  rawSourceVersion       String?
  extractedAt            DateTime?
  extractionBatchId      String?
  normalizationVersion   String?

  @@index([propertyCode])
  @@index([createdAt])
  @@index([status])
}

/// عرضه و تقاضا — عین گزارش realtor-reports/supply-demand سامانه ARM:
/// بازه × تعداد آگهی × درصد درخواست × وضعیت
model SupplyDemandRecord {
  id             String   @id
  /// عنوان بازه (مثلاً «۰ تا ۵۰ میلیون تومان»)
  rangeTitle     String
  /// تعداد آگهی در این بازه
  propertyCount  Int      @default(0)
  /// درصد درخواست نسبت به عرضه
  requestPercent Float    @default(0)
  /// وضعیت بازه (رشته فارسی سامانه)
  status         String   @default("")
  syncedAt       DateTime @default(now())

  /// B.3 (P6.5-04-v2) — provenance سه‌لایه حقیقت (نوشتهٔ مسیر sync — این جدول مسیر Bulk ندارد)
  /// rawSourceVersion تهی صادقانه (ARM نسخه منتشر نمی‌کند) · normalizationVersion تهی (موتور نرمال‌سازی روی این جدول اجرا نمی‌شود — عناوین بازه عین منبع می‌مانند)
  rawSourceVersion     String?
  extractedAt          DateTime?
  extractionBatchId    String?
  normalizationVersion String?

  @@index([rangeTitle])
}

/// گزارش استخراج اطلاعات — فقط افزودنی (Append-only):
/// هر استعلام کدآگهی/کددرخواست با نتیجه واقعی از سامانه ARM ثبت می‌شود؛
/// منبع حافظه و بینش ایجنت استخراج اطلاعات + رد حسابرسی امنیتی.
model LookupLog {
  id           String   @id @default(cuid())
  /// نوع استعلام: PROPERTY (کدآگهی) | REQUEST (کددرخواست)
  kind         String
  /// کد واردشده توسط کاربر
  code         String
  /// آیا رکورد در سامانه پیدا شد؟
  found        Boolean  @default(false)
  /// نام و نام خانوادگی مالک/درخواست‌دهنده
  personName   String?
  /// شماره تماس مالک/درخواست‌دهنده
  personMobile String?
  /// آدرس ملک (فقط برای کدآگهی)
  address      String?
  /// کد پرسنلی استعلام‌کننده
  actorCode    String
  /// پیام خطا (در صورت عدم موفقیت)
  errorNote    String?
  createdAt    DateTime @default(now())

  @@index([kind, code])
  @@index([createdAt])
}

// ===================== فایل‌یابی از دیوار =====================

/// اتصال دیوار — دو روش (کنار با کلید API | موبایل+کد پیامکی) — هر روش یک رکورد
model DivarConnection {
  id            String    @id @default(cuid())
  /// kenar | phone
  method        String    @unique
  /// connected | disconnected | pending | error
  status        String    @default("disconnected")
  /// کلید API کنار — رمزنگاری‌شده AES-256-GCM
  apiKeyEnc     String?
  /// شماره موبایل متصل (روش پیامکی)
  phone         String?
  /// توکن نشست دیوار — رمزنگاری‌شده
  tokenEnc      String?
  /// نام نمایشی (مثلاً نام کسب‌وکار کنار)
  displayName   String?
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// تنظیمات ایجنت فایل‌یابی — تک‌رکورد (singleton)
model DivarSetting {
  id            String   @id // "singleton"
  /// JSON کامل تنظیمات (وزن‌ها، آستانه‌ها، بازه زمانی، دسته‌ها، مناطق/محله‌ها)
  dataJson      String
  /// پرچم مهاجرت یک‌باره فیلتر مکان (اعمال ۱۷ منطقه پیش‌فرض مالک روی نصب‌های قدیمی)
  locFilterInit Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

/// آگهی دیوار (فایل) — فقط آگهی‌های داخل بازه زمانی و در حالت فعال ذخیره می‌شوند.
/// آگهی ردشده (سیستم یا کاربر) هرگز آرشیو نمی‌شود — رکورد حذف و فقط سیگنال یادگیری می‌ماند.
model DivarAd {
  /// توکن آگهی دیوار (شناسه یکتا)
  token           String    @id
  /// دسته دیوار (apartment-sell و …)
  category        String
  title           String
  description     String?
  /// متن خام قیمت
  priceText       String?
  /// قیمت کل (تومان)
  price           Float?
  /// قیمت هر متر (تومان)
  pricePerMeter   Float?
  /// متراژ
  meterage        Float?
  /// تعداد اتاق
  rooms           Int?
  /// طبقه
  floor           Int?
  /// سال ساخت
  buildYear       Int?
  /// زمان واقعی انتشار آگهی (از «انتشار آگهی» جزئیات دیوار)
  publishedAt     DateTime?
  /// آخرین نردبان/به‌روزرسانی
  bumpedAt        DateTime?
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  /// متن مکان دیوار («۳ روز پیش در تبریز، خ …»)
  locationText    String?
  latitude        Float?
  longitude       Float?
  /// تطبیق با سامانه آرم
  matchedAreaId   String?
  matchedAreaName String?
  matchedLineId   String?
  matchedLineName String?
  /// امتیازها ۰..۱۰۰
  personalScore   Float     @default(0)
  underpriceScore Float     @default(0)
  locationScore   Float     @default(0)
  /// امتیاز «سایر فاکتورهای فایل بهینه» — شاهکار ایجنت (۰..۱۰۰)
  otherScore      Float     @default(0)
  totalScore      Float     @default(0)
  /// hunt | follow | review
  bucket          String    @default("review")
  /// active | registered | rejected
  status          String    @default("active")
  /// تحلیل JSON: سیگنال‌های شخصی/زیرقیمت/مکان + دلایل
  analysisJson    String?
  /// تصاویر (آرایه URL)
  imagesJson      String?
  /// مشخصات خام (specها)
  specsJson       String?
  /// کلید تغییر (token+price) برای تشخیص تغییر مهم در اسکن‌های بعدی
  changeKey       String?

  /// نوع آگهی‌دهنده — برچسب زیر نقشه دیوار (personal | agent | department | business)
  publisherType     String?
  /// نام کسب‌وکار املاک («گروه مشاورین املاک طاهری») — شخصی: null
  publisherName     String?
  /// تعداد آگهی فعال کسب‌وکار («۸ آگهی فعال» → 8)
  publisherAdCount  Int?
  /// پل به صفحه برند کسب‌وکار در دیوار (divar.ir/pro/…)
  publisherBrandUrl String?

  @@index([bucket, totalScore])
  @@index([status, publishedAt])
  @@index([category])
  @@index([matchedLineId])
  @@index([totalScore])
}

/// سیگنال یادگیری از رد آگهی — فقط افزودنی؛ خود آگهی هرگز آرشیو نمی‌شود
model DivarRejectLog {
  id                  String   @id @default(cuid())
  /// توکن آگهی ردشده
  token               String
  /// دلایل انتخابی کاربر (JSON آرایه کلیدها)
  reasons             String
  /// توضیحات دلخواه کاربر
  note                String?
  /// تصویر لحظه‌ای امتیازها هنگام رد (JSON) — مبنای یادگیری
  scoreSnapshotJson   String?
  /// ویژگی‌های متنی آگهی برای یادگیری (عنوان/دسته/محله/قیمت) — بدون آرشیو آگهی
  featureSnapshotJson String?
  actorCode           String
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@index([token])
}

/// آمار قیمت بازار برای فیلتر زیرقیمت — به‌روزشونده با هر اسکن
model MarketPriceStat {
  id             String   @id @default(cuid())
  /// کلید دامنه: line:{lineId} | area:{areaId} | cat:{category}
  scopeKey       String   @unique
  /// میانگین (میانه) قیمت هر متر — تومان
  medianPerMeter Float
  /// چارک ۲۵
  p25PerMeter    Float
  /// چارک ۷۵
  p75PerMeter    Float
  sampleCount    Int
  /// قیمت مرجع آرم برای همین دامنه (اگر موجود) — تومان بر متر
  armPerMeter    Float?
  updatedAt      DateTime @updatedAt
}

/// گزارش اجرای اسکن دیوار
model DivarScanLog {
  id           String   @id @default(cuid())
  startedAt    DateTime @default(now())
  durationMs   Int      @default(0)
  /// آگهی‌های دیده‌شده در صفحات جستجو
  scanned      Int      @default(0)
  /// جزئیات تازه گرفته‌شده
  fetched      Int      @default(0)
  /// داخل بازه زمانی انتشار
  inWindow     Int      @default(0)
  /// آگهی‌های درون بازه که بیرون از مناطق انتخابی مالک بودند و ذخیره نشدند
  outOfArea    Int      @default(0)
  /// آگهی‌های غیرشخصی (مشاور/دپارتمان املاک) که به‌موجب قانون مالک خودکار رد شدند
  autoRejected Int      @default(0)
  newAds       Int      @default(0)
  updatedAds   Int      @default(0)
  /// منبع: web | kenar
  source       String   @default("web")
  error        String?

  @@index([startedAt])
}

// ===================== قراردادها و اسناد (صورت وضعیت سامانه ARM) =====================

/// قرارداد (صورت وضعیت) — عین ساختار trade-overviews خود سامانه ARM:
/// چرخه کامل عمر از «پیش‌نویس» تا «در انتظار تنظیم سند» با وضعیت‌های واقعی سامانه.
model ContractRecord {
  id                   String    @id
  /// وضعیت واقعی سامانه: preDefined | waitingForAddRealtors | waitingForRealtors |
  /// waitingForFinance | confirmedByFinance | rejectedByFinance | waitingForDocument |
  /// rejected | finished | payed | rescission | deletedByFinance
  status               String
  /// شماره هولوگرام قرارداد (شناسه رسمی سند)
  contractHolo         String?
  /// کد آگهی ملک
  propertyCode         String?
  /// کد درخواست خرید
  requestCode          String?
  /// نوع قرارداد (مبایعه‌نامه / اجاره‌نامه / تمدید اجاره)
  contractType         String?
  /// ثبت‌کننده قرارداد
  creatorName          String?
  /// تاریخ ثبت
  createdAt            DateTime?
  /// تاریخ قرارداد
  contractDate         DateTime?
  /// تاریخ سند (تنظیم سند رسمی)
  documentDate         DateTime?
  /// تاریخ تحویل ملک
  deliveryDate         DateTime?
  /// عنوان ملک
  propertyTitle        String?
  /// آدرس ملک
  propertyAddress      String?
  /// خریداران — JSON [{fullName, mobileNumber}]
  buyerListJson        String?
  /// فروشندگان — JSON [{fullName, mobileNumber}]
  sellerListJson       String?
  /// مشاوران و حق‌السهم — JSON [{name, unitPercent, confirmation, description, role}]
  realtorListJson      String?
  /// آیا امکان افزودن مشاور دارد (مرحله در انتظار افزودن مشاور)
  canAddRealtor        Boolean   @default(false)
  /// P6.5-12 — مبلغ قرارداد (ریال — از contractPrice رشته‌ای سامانه)
  contractPrice        Float?
  /// P6.5-12 — لایه ۱ حقیقت: مبلغ خام عین منبع (رشته)
  rawContractPrice     String?
  /// P6.5-12 — کمیسیون قرارداد (ریال)
  comisionOfContract   Float?
  /// P6.5-12 — مالیات قرارداد (ریال)
  taxOfContract        Float?
  /// P6.5-12 — شناسهٔ کسب‌وکار (از trade-overviews/info — کلید مشترک سامانه‌ها)
  businessId           String?
  syncedAt             DateTime  @default(now())
  /// P6.5-03 — شناسه آخرین اجرای Bulk که این رکورد را نوشت (محافظت از جاروی sync — §۱.۹)
  sourceRunId          String?
  /// P6.5-04-e-v2 — لایه ۱ حقیقت: تاریخ خام عین منبع (پیش از تبدیل جلالی؛ هرگز توسط نرمال‌سازی تغییر نمی‌کند)
  rawDate              String?
  /// B.3 (P6.5-04-v2) — لایه ۱ حقیقت: نام ثبت‌کننده و عنوان ملک خام عین منبع
  rawCreatorName       String?
  rawPropertyTitle     String?
  /// P6.5-04-e-v2 — ستون‌های سه‌لایه حقیقت (provenance؛ ARM فعلاً نسخه منتشر نمی‌کند)
  rawSourceVersion     String?
  extractedAt          DateTime?
  extractionBatchId    String?
  normalizationVersion String?

  @@index([status])
  @@index([contractHolo])
  @@index([createdAt])
}

// ===================== رجیستری‌های P6.5 (Data Readiness — زیرساخت Bulk) =====================

/// P6.5-02 (§۲.۲ طراحی) — کش آگهی‌های ARM (تاریخی + جاری)؛ کلید طبیعی: propertyCode.
/// مدل جدید افزودنی: جدول خالی در این گام — زیرساخت Bulk Import (P6.5-03)؛
/// ListingRecord داخلی (فرم ۵ گامی) دست‌نخورده — پل آینده: ListingRecord.armPropertyId.
model PropertyRecord {
  id                   String    @id // شناسه ARM (objectId)
  propertyCode         String    @unique // کدآگهی ARM — کلید طبیعی
  title                String?
  status               String?
  // انتساب Scope (§۵)
  ownerCode            String? // relatedRealtor → personnelCode
  ownerName            String?
  branchId             String?
  // مکان (تطبیق‌یافته با رجیستری ۹۲۶ محله — §۳ طراحی)
  cityId               String?
  areaId               String?
  areaName             String?
  lineId               String?
  lineName             String?
  address              String?
  // مشخصات
  propertyTypeId       String?
  propertyTypeName     String?
  tradeTypeId          String?
  tradeTypeName        String?
  price                Float? // ریال — عدد پایه (§۳.۵ مرز واحد پول)
  pricePerMeter        Float? // ریال
  meterage             Float?
  rooms                Int?
  floor                Int?
  buildYear            Int?
  // متن و خام
  description          String?
  detailsJson          String? // [{label, value}] عین ARM
  ownerMobile          String? // نرمال‌شده 09xxxxxxxxx
  tenantId             String?   @default("melk-tabriz") // §۱۴ مصوبه شورا — آماده، غیرفعال
  sourceRunId          String? // آخرین bulk-run که رکورد را نوشت
  // P6.5-04-e-v2 — لایه ۱ حقیقت (Raw): مقادیر عین منبع؛ هرگز توسط نرمال‌سازی تغییر نمی‌کنند
  rawPrice             String? // متن/عدد خام مبلغ (پیش از parseAmount)
  rawPriceUnit         String? // واحد جدا اگر منبع جدا کرده باشد (تومان/میلیارد…)
  rawArea              String? // متن/عدد خام متراژ (پیش از parse)
  // B.3 (P6.5-04-v2) — لایه ۱ حقیقت: نام/موبایل مالک خام عین منبع
  rawOwnerName         String?
  rawOwnerMobile       String?
  // P6.5-04-e-v2 — provenance سه‌لایه
  rawSourceVersion     String? // نسخه داده منبع (ARM فعلاً منتشر نمی‌کند — تهی تا کشف Reconnaissance)
  extractedAt          DateTime? // زمان استخراج
  extractionBatchId    String? // شناسه دسته استخراج (= runId)
  normalizationVersion String? // نسخه موتور نرمال‌سازی
  syncedAt             DateTime  @default(now())
  createdAt            DateTime?
  updatedAt            DateTime  @updatedAt

  // ===================== PN-002 گام ۱ — ستون‌های تازه از خود ردیف فهرست ARM =====================
  // (بهینه‌ترین گزینهٔ استخراج: خود properties/list — صفر هزینهٔ API اضافه)
  isRental       Boolean? // نوع اجاره‌ای (isRental خود ردیف)
  depositPrice   Float? // رهن (deposite_price)
  rentPrice      Float? // اجاره (rent_price)
  viewCount      Int? // بازدید آگهی (viewCount)
  imageCount     Int? // تعداد تصویر (images.length)
  addedToDivar   Boolean? // منتشرشده در دیوار
  addedToInsta   Boolean? // منتشرشده در اینستاگرام
  isReposted     Boolean? // بازنشرشده
  isTarget       Boolean? // آگهی هدف
  armBranchTitle String? // کسب‌وکار/شعبهٔ مستقیم ARM (businessId.title)
  stateName      String? // استان (state.name)
  cityName       String? // شهر (city.name)
  publicUrl      String? // لینک عمومی آگهی (link)
  statusDate     DateTime? // تاریخ آخرین وضعیت (status[0].date)

  // ---------- PN-027 · ۵-پ-۲ — ستون‌های سایهٔ نرمال برای فیلتر متنی سطح-SQL ----------
  /// norm(ownerName) — فیلتر «کارشناس/مغایر» M1 (پیش‌تر JS روی ۲۷٫۸k ردیف)
  realtorNameNorm  String?
  /// norm(rawOwnerName) ␟ norm(ownerMobile) — فیلتر «مالک»: نام یا موبایل (هم‌ارز JS قدیم)
  ownerSearchNorm  String?
  /// norm(address) ␟ norm(areaName) ␟ norm(lineName) — فیلتر «آدرس/محله» (هم‌ارز JS قدیم)
  addressSearchNorm String?

  @@index([cityId, areaId, propertyTypeId, tradeTypeId]) // ایندکس ۱ از §۴
  @@index([price, meterage]) // ایندکس ۲ از §۴
  @@index([createdAt]) // ایندکس ۴ از §۴
  @@index([ownerCode]) // پشتیبان ConsultantScope
  @@index([tenantId])
  // PN-027 · ۵-پ-۲ — ایندکس ستون‌های نرمال (پیشوند/دقیق؛ contains روی سطح SQLite می‌ماند)
  @@index([realtorNameNorm])
  @@index([ownerSearchNorm])
  @@index([addressSearchNorm])
}

/// P6.5-02 (§۲.۳ طراحی) — رجیستری مشتریان مشتق (خریدار/فروشنده/درخواست‌دهنده/مالک)؛ افزودنی.
/// جدول خالی در این گام — پرشدگی در Bulk Import (P6.5-03) با کلید منطقی mobile ?? "pc:"+personnelCode.
model CustomerRecord {
  id               String    @id @default(cuid())
  mobile           String? // کلید طبیعی اول — نرمال‌شده
  personnelCode    String? // fallback (کاربر پرسنلی)
  fullName         String // نرمال‌شده نام (§۳.۲)
  rolesJson        String? // ["buyer","seller","requester","owner"]
  sourceCountsJson String? // {contract: n, request: n, property: n, visit: n}
  ownerCode        String? // کارشناس مرتبط (انتساب Scope — §۵)
  branchId         String?
  firstSeenAt      DateTime? // قدیمی‌ترین تاریخ رکورد منبع
  lastSeenAt       DateTime?
  tenantId         String?   @default("melk-tabriz") // §۱۴ مصوبه شورا — آماده، غیرفعال
  sourceRunId      String?
  updatedAt        DateTime  @updatedAt

  @@index([fullName])
  @@index([ownerCode])
  @@index([mobile])
  @@index([tenantId])
}

// ===================== کش فهرست‌های مرجع عمومی سامانه ARM =====================

/// کش فهرست‌های عمومی (بدون توکن) — شخصیت/شغل/نقش/جدیت مشتریان،
/// پیکربندی شاخص قیمت روز، تعرفه کمیسیون اتحادیه. یک رکورد برای هر کلید.
model RefListCache {
  /// کلید یکتا: user-characters | user-jobs | user-roles | user-seriousness |
  /// price-indices | commission-config
  key       String   @id
  /// JSON کامل فهرست (عین پاسخ سامانه)
  dataJson  String
  fetchedAt DateTime @updatedAt
}

// ===================== شاخص قیمت روز مناطق =====================

/// تاریخچه شاخص قیمت هر منطقه — فقط افزودنی (Append-only):
/// هر اسکن/بازخوانی، میانگین قیمت هر متر منطقه را ثبت می‌کند؛
/// مبنای «روند تغییر شاخص‌ها در زمان» و «هشدار تغییرات جهشی».
model PriceIndexHistory {
  id             String   @id @default(cuid())
  /// نام منطقه (خط/محله تبریز)
  areaName       String
  /// دسته آگهی (apartment-sell و ...)
  category       String
  /// میانگین (میانه) قیمت هر متر — تومان
  medianPerMeter Float
  /// چارک ۲۵
  p25PerMeter    Float
  /// چارک ۷۵
  p75PerMeter    Float
  /// کمترین و بیشترین قیمت هر متر در نمونه
  minPerMeter    Float
  maxPerMeter    Float
  sampleCount    Int
  recordedAt     DateTime @default(now())

  @@index([areaName, recordedAt])
  @@index([category])
}

// ===================== مالی و کمیسیون =====================

/// گزارش محاسبات کمیسیون — فقط افزودنی:
/// هر محاسبه با تعرفه واقعی اتحادیه ثبت می‌شود؛ حافظه ایجنت مالی.
model CommissionCalcLog {
  id           String   @id @default(cuid())
  /// نوع قرارداد: mobayeName | ejareName | rentalRenewal
  contractType String
  /// ورودی‌ها — JSON (ثمن معامله / ودیعه / اجاره)
  inputsJson   String
  /// نتیجه — JSON (کمیسیون خریدار/فروشنده، مالیات، قابل پرداخت)
  resultJson   String
  /// ثمن معامله معادل (برای تجمیع درآمد)
  dealValue    Float    @default(0)
  /// سهم مالیات ارزش افزوده اعمال‌شده (درصد)
  vatPercent   Float    @default(10)
  actorCode    String
  createdAt    DateTime @default(now())

  @@index([contractType])
  @@index([createdAt])
}

// ===================== کاشی آگهی (ثبت/انتقال فایل آگهی) =====================

/// فایل آگهی — عین ساختار ۵ گامی فرم ثبت آگهی خود سامانه ARM (new-property-page):
/// گام ۱ اطلاعات مالک ← گام ۲ اطلاعات مکانی ← گام ۳ اطلاعات معامله ← گام ۴ تصاویر و اسناد ← گام ۵ توضیحات مشاوران
/// دو منبع ثبت: دستی (مالک حضوری) و خودکار (فایل‌های تأییدشده کاشی فایل‌یابی)
/// دو مقصد انتقال: سامانه ARM (کلید انتقال به CRM) و اینستاگرام (کلید انتقال به اینستاگرام)
model ListingRecord {
  id         String  @id @default(cuid())
  /// manual | divar — منبع ثبت فایل آگهی
  source     String  @default("manual")
  /// توکن آگهی دیوار (برای منبع divar — پیوند به DivarAd)
  divarToken String?

  // ---------- گام ۱: اطلاعات مالک ----------
  /// نام و نام‌خانوادگی مالک
  customerName   String?
  /// شماره موبایل مالک (۱۱ رقم با ۰۹)
  customerMobile String?
  /// شناسه کاربر آرم (پس از جستجو/ایجاد در فرآیند انتقال به CRM)
  armCustomerId  String?

  // ---------- گام ۲: اطلاعات مکانی ملک ----------
  areaId     String?
  areaName   String?
  lineId     String?
  lineName   String?
  postalCode String?
  address    String?
  latitude   Float?
  longitude  Float?

  // ---------- گام ۳: اطلاعات معامله ----------
  tradeTypeId      String?
  tradeTypeName    String?
  propertyTypeId   String?
  propertyTypeName String?
  buildingTypeId   String?
  buildingTypeName String?
  /// معاوضه — JSON آرایه مقادیر PROPERTY_CHANGEABLE_WITH (notChangeable/land/…)
  changeWithJson   String?
  /// فرم پویای دسته‌بندی — JSON {createName: value} (مساحت/اتاق/طبقه/سال ساخت…)
  inputsJson       String?

  // ---------- گام ۴: تصاویر و اسناد ----------
  /// تصاویر — JSON آرایه URL (اولین = تصویر اصلی)
  imagesJson    String?
  /// ویدیوها — JSON آرایه URL
  videosJson    String?
  /// اسناد — JSON آرایه URL
  documentsJson String?

  // ---------- گام ۵: توضیحات مشاوران ----------
  /// قیمت فایل (تومان — رشته عددی)
  priceEvaluation   String?
  /// مطلوبیت فایل
  desirabilityLevel String?
  /// نحوه پیدا شدن فایل (دیوار/حضوری/معرفی/…)
  fileFinding       String?
  /// انواع فایل — JSON آرایه
  fileTypeJson      String?
  /// جدیت مشتری
  userSeriousness   String?
  /// دلیل فروش
  sellReason        String?
  /// توضیحات مشاوران
  description       String?
  /// برچسب‌های فایل (عین فرم آرم)
  isLuxury          Boolean @default(false)
  isVacation        Boolean @default(false)
  isUrgent          Boolean @default(false)
  /// اطلاع‌رسانی با پیامک (عین فرم آرم)
  notifyBySms       Boolean @default(false)

  /// چرخه عمر: draft (در تکمیل) | ready (آماده) | archived
  status String @default("draft")

  /// نتیجه انتقال به CRM — JSON {steps:[{key,title,status,detail}], armId, at}
  crmTransferJson  String?
  crmTransferredAt DateTime?
  /// شناسه آگهی ثبت‌شده در آرم
  armPropertyId    String?

  /// آخرین محتوای اینستاگرام — JSON {kind, caption, media, tone}
  instagramPostJson    String?
  instagramPublishedAt DateTime?
  /// شناسه پست منتشرشده در اینستاگرام
  instagramMediaId     String?

  /// کد پرسنلی ثبت‌کننده
  actorCode String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// P6.5-02 (§۵.۳) — شعبه انتساب Scope
  branchId String?
  /// P6.5-02 (§۱۴ مصوبه شورا) — آماده‌سازی چند-مستأجری — nullable + default، بدون منطق فعال
  tenantId String? @default("melk-tabriz")

  @@index([status])
  @@index([source])
  @@index([divarToken])
  @@index([createdAt])
  @@index([crmTransferredAt])
  @@index([instagramPublishedAt])
}

/// اتصال حساب اینستاگرام کسب‌وکار (Instagram Graph API) — تک‌رکورد
model InstagramConnection {
  id            String    @id @default(cuid())
  /// connected | disconnected | error
  status        String    @default("disconnected")
  /// شناسه حساب اینستاگرام کسب‌وکار (IG User ID)
  igUserId      String?
  username      String?
  displayName   String?
  /// توکن دسترسی Graph API — رمزنگاری‌شده AES-256-GCM
  tokenEnc      String?
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// گزارش محتوای اینستاگرام — فقط افزودنی (Append-only):
/// هر تولید محتوا/انتشار پست یا رییلز ثبت می‌شود؛ حافظه ایجنت آگهی.
model InstagramPostLog {
  id          String    @id @default(cuid())
  listingId   String
  /// post | reel
  kind        String
  /// کپشن تولیدشده (متن کامل پست)
  caption     String
  /// رسانه — JSON آرایه URL
  mediaJson   String
  /// generated | approved | published | failed
  status      String    @default("generated")
  /// نتیجه انتشار Graph API — JSON
  resultJson  String?
  publishedAt DateTime?
  actorCode   String
  createdAt   DateTime  @default(now())

  @@index([listingId])
  @@index([createdAt])
  @@index([status])
}

/// اتصال حساب شخصی سامانه پرسنلی PM — تک‌رکورد (کد پرسنلی + پیامک، عین خود سامانه pm)
model PmConnection {
  id              String    @id @default(cuid())
  /// connected | disconnected | pending | error
  status          String    @default("disconnected")
  personnelCode   String?
  displayName     String?
  /// توکن دسترسی PM — رمزنگاری‌شده
  tokenEnc        String?
  /// توکن تمدید PM — رمزنگاری‌شده
  refreshTokenEnc String?
  lastCheckedAt   DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// P6546/گام صفر — اتصال به سامانه GAP (سامانه گفت‌وگوی آنلاین ملک تبریز)
/// همان الگوی PmConnection: ردیف یگانه با وضعیت و توکن رمزنگاری‌شده
model GapConnection {
  id              String    @id @default(cuid())
  /// connected | disconnected | pending | error
  status          String    @default("disconnected")
  personnelCode   String?
  displayName     String?
  /// توکن دسترسی GAP — رمزنگاری‌شده
  tokenEnc        String?
  /// توکن تمدید GAP — رمزنگاری‌شده
  refreshTokenEnc String?
  lastCheckedAt   DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// P6.5-11 (بند ث) — صندوقچهٔ ماندگار توکن‌های ARM — جدا از چرخهٔ عمر نشست.
/// مشکل: توکن ARM فقط در Session ذخیره می‌شد و با هر خروج/انقضای نشست پاک می‌شد
/// ⇒ مالک در «هر ورود» مجبور به تجدید اتصال با پیامک بود.
/// راه‌حل: این جدول توکن‌های ARM را «فراتر از نشست» نگه می‌دارد؛ در هر ورود
/// (کد مستر یا OTP) به‌طور خودکار به نشست تازه بازیابی می‌شود (اتصال ماندگار).
/// SEC-3 حفظ می‌شود: بازیابی فقط برای همان کد پرسنلی؛ نشست OWNER (کد مستر)
/// فقط جدیدترین رکورد مالک را برمی‌گرداند.
model ArmConnection {
  id              String    @id @default(cuid())
  /// کد پرسنلی SAM که توکن با آن گرفته شده (کلید بازیابی OTP) — برای کد مستر: «master»
  ownerKey        String    @unique
  /// کد پرسنلی واقعی ARM که پیامک آن گرفته شد (اطلاعاتی)
  personnelCode   String?
  displayName     String?
  userType        String?
  /// توکن دسترسی ARM — رمزنگاری‌شده AES-256-GCM (عین Session.armTokenEnc)
  tokenEnc        String?
  /// توکن تمدید ARM — رمزنگاری‌شده
  refreshTokenEnc String?
  /// connected | disconnected | error
  status          String    @default("connected")
  lastRefreshedAt DateTime?
  lastRestoredAt  DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// P6.5-11 (بند ب) — نقطهٔ ازسرگیری خط لولهٔ کاتالوگ ARM — «ادامه از جاییکه قطع شد».
/// قانون: دادهٔ صفحه اول نوشته شود، سپس checkpoint جلو برود (عین bulk-import §۱.۴-۳)؛
/// هرگز از صفر شروع نمی‌شود مگر چرخهٔ قبلی کامل شده باشد (بروزرسانی = چرخهٔ تازه).
model SyncCheckpoint {
  /// کلید موجودیت: listings | requests | enrich-listings | enrich-requests | main-sync | tx-info-enrich
  id                String    @id
  /// شناسهٔ چرخهٔ جاری (هر چرخهٔ کامل = runId تازه)
  cycleId           String
  pageSize          Int       @default(50)
  /// آخرین صفحهٔ «کامل-ذخیره‌شده» (ادامه = lastCompletedPage + 1)
  lastCompletedPage Int       @default(0)
  totalPages        Int       @default(0)
  totalAtSource     Int       @default(0)
  /// in-progress | complete
  phase             String    @default("in-progress")
  completedAt       DateTime?
  updatedAt         DateTime  @updatedAt
  createdAt         DateTime  @default(now())
}

/// P6.5-14 (ملکا-شورا-۱۴۰۵-۰۱۷ — BLOCK C) — غنی‌سازی معامله‌محور معاملات.
/// برای هر معامله، پاسخ خام «trade-overviews/info/{txId}» (لایه ۱ حقیقت — عین منبع)
/// + فیلدهای نگاشت‌شدهٔ لایه ۲. جدول افزودنی مستقل از جاروی sync اصلی
/// (deleteMany+createMany هرگز این جدول را لمس نمی‌کند — قانون دادهٔ مقدس).
model TransactionEnrichment {
  /// = TransactionRecord.id (شناسهٔARM صورت‌وضعیت)
  txId               String    @id
  /// نوع قرارداد — برچسب فارسی عین منبع (مبایعه نامه / اجاره نامه / تمدید اجاره)
  contractType       String?
  /// مبلغ قرارداد (ریال — از contractPrice رشته‌ای منبع)
  contractPrice      Float?
  /// لایه ۱ حقیقت: مبلغ خام عین منبع (رشته)
  rawContractPrice   String?
  /// نام خریدار (اولین طرف دارای نام از buyerList)
  buyerName          String?
  /// موبایل خریدار (نرمال‌شده: ۰۹…)
  buyerMobile        String?
  /// نام فروشنده (اولین طرف دارای نام از sellerList)
  sellerName         String?
  /// موبایل فروشنده (نرمال‌شده: ۰۹…)
  sellerMobile       String?
  /// کل خریداران عین منبع — JSON [{fullName, mobileNumber}]
  buyerListJson      String?
  /// کل فروشندگان عین منبع — JSON [{fullName, mobileNumber}]
  sellerListJson     String?
  /// مشاوران و حق‌السهم — JSON [{name, unitPercent, confirmation, role}]
  realtorSharesJson  String?
  /// عنوان ملک (property.title)
  propertyTitle      String?
  /// آدرس ملک (property.address)
  propertyAddress    String?
  /// وضعیت صورت‌وضعیت عین منبع
  status             String?
  documentDate       DateTime?
  deliveryDate       DateTime?
  businessId         String?
  comisionOfContract Float?
  taxOfContract      Float?
  /// لایه ۱ حقیقت: کل پاسخ info عین منبع (پژوهش/ممیزی آینده)
  rawInfoJson        String?
  syncedAt           DateTime  @default(now())
  /// شناسهٔ دستهٔ غنی‌سازی (P6.5-14)
  extractionBatchId  String?

  @@index([contractType])
  @@index([extractionBatchId])
}

/// PN-008 (ثانیاً) — پروفایل کارشناس از سامانهٔ PM (منبع یگانهٔ فهرست تازهٔ کارشناسان).
/// جایگزین کامل PmPersonnelRecord نسل قدیمی (حذف‌شده طبق دستور مالک ۱۴۰۵/۰۷/۱۶).
/// کشف سرد بی‌پیش‌فرض ۱۴۰۵/۰۷/۱۶ (شاهد: download/pn008/pm-exploration.json):
///   رجیستری realtors/list: code (کدپرسنلی) + fullName + mobileNumber + role + voipInfo + activationStatus — 100٪ پر (۱۴۳ پرسنل)
///   عمق personnelInfo: employeementInfo.date (استخدام) + branchId.title (شعبه) + headRealtor + role — نمونهٔ ۱۲/۱۲ پر
///   عمق contactInfo: contactInfo.address + telephoneNumber + postalCode + voip + city/state — نمونهٔ ۱۲/۱۲ پر
/// ستون‌های الزامی مالک + ستون‌های کشف‌شده، همگی در این یک مدل.
model ExpertProfile {
  /// شناسهٔ مشترک با ExpertRecord.id و سامانه PM/ARM (_id)
  id               String   @id
  /// کدپرسنلی (مثال: 410031320) — عین فیلد code رجیستری PM
  personnelCode    String?
  /// نام کارشناس
  fullName         String?
  /// موبایل (زیر نام در فهرست نمایش داده می‌شود)
  mobile           String?
  /// سمت پرسنلی (personnelInfo.role.title — «مشاور فروش»)
  roleTitle        String?
  /// شعبه (personnelInfo.branchId.title — «باغلارباغی»/«ارتش»/…)
  branchTitle      String?
  /// شناسهٔ شعبه (personnelInfo.branchId._id)
  branchCode       String?
  /// تاریخ استخدام خام PM (ISO — employeementInfo.date)
  hireDate         String?
  /// نوع همکاری: 1 = حق السهم (درصد) · 3 = حقوق ماهیانه (employeementInfo.type)
  employmentType   Int?
  /// مدیر مستقیم (personnelInfo.headRealtor.fullName)
  headManager      String?
  /// آدرس دقیق کارشناس (contactInfo.contactInfo.address)
  address          String?
  /// تلفن ثابت (contactInfo.contactInfo.telephoneNumber)
  telephone        String?
  /// کد پستی (contactInfo.contactInfo.postalCode)
  postalCode       String?
  /// شماره داخلی تلفن سازمانی (voipInfo.extentionNumber)
  voipExtension    String?
  /// شهر (contactInfo.city.name)
  city             String?
  /// استان (contactInfo.state.name)
  state            String?
  /// کسب‌وکار (businessId.title — «ملک تبریز»)
  businessTitle    String?
  /// وضعیت فعال‌سازی پلتفرم‌ها — JSON {ps,acc,apm,chat}
  activationJson   String?
  /// فعال بودن (isRegisteredCompleted + activationStatus)
  active           Boolean  @default(true)
  /// شمار مبایعه‌نامه + پیش‌فروش — محاسبه از دادهٔ ARM (قرارداد + گزارش تطابق)
  saleCount        Int      @default(0)
  /// شمار اجاره‌نامه + تمدید اجاره — محاسبه از دادهٔ ARM
  rentCount        Int      @default(0)
  /// لایهٔ خام رجیستری (قانون دادهٔ مقدس — عین منبع)
  rawRegistryJson  String?
  /// لایهٔ خام personnelInfo
  rawPersonnelJson String?
  /// لایهٔ خام contactInfo
  rawContactJson   String?
  syncedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([personnelCode])
  @@index([branchTitle])
  @@index([fullName])
}

/// PN-008 BLOCK 7 — مدیریت دسترسی کدپرسنلی‌ها به داشبورد (تنظیمات عمومی مالک)
/// سه سطح (دستور مالک ۱۴۰۵/۰۷/۱۶): full = همهٔ کاشی‌ها · limited = کاشی‌های انتخابی · none = هیچ
/// قید حیاتی (قانون هویت دوگانهٔ مالک): کد در OWNER_PERSONNEL_CODES همیشه full — حتی اگر رکورد داشته باشد.
model PersonnelAccess {
  /// کد پرسنلی (مثال: 410031320)
  personnelCode String   @id
  /// 'full' | 'limited' | 'none'
  level         String
  /// کاشی‌های مجاز — JSON آرایه (مثال: ["arm-listings","experts"]) — فقط برای limited
  allowedTiles  String?
  grantedAt     DateTime @default(now())
  /// ثبت‌کننده (کد مالک)
  grantedBy     String
  notes         String?
  updatedAt     DateTime @updatedAt
}

/// PN-016 — سیستم مدیریت کاربران پیشرفته (شورا-ن۰۲۰ بند ۵.۲.۱).
/// User = منبع یکتای هویت هر انسانِ سامانه (پرسنل با personnelCode، مهمان با mobile).
/// نکته: Prisma روی SQLite از enum پشتیبانی نمی‌کند → role به‌صورت String با
/// اعتبارسنجی سطح-اپ (USER_ROLES در src/lib/users/user-model.ts).
model User {
  id             String    @id @default(cuid())
  /// کد پرسنلی (یکتا؛ فقط برای کاربران پرسنلی — مهمان null)
  personnelCode  String?   @unique
  /// موبایل (یکتا؛ فقط برای مهمان‌ها — پرسنل می‌تواند null باشد)
  mobile         String?   @unique
  fullName       String
  /// OWNER | MANAGER | EXPERT | VIEWER | GUEST (اعتبارسنجی سطح-اپ)
  role           String    @default("VIEWER")
  /// شعبه (از PM/businesses)
  branchTitle    String?
  /// سمت فارسی (از PM/roleTitle — مثال: «مشاور املاک»)
  roleTitleFa    String?
  /// غیرفعال = ورود ممنوع؛ نشست‌های فعال باقی می‌مانند تا انقضا/بستن دستی
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  /// چه کسی ساخت (personnelCode مالک یا userId)
  createdBy      String?
  lastLoginAt    DateTime?
  lastLoginIp    String?
  failedAttempts Int       @default(0)
  /// قفل حساب تا این لحظه (نرخ‌سنج ورود)
  lockedUntil    DateTime?
  /// JSON آزاد (مثال: منبع ساخت: seed|pm-backfill|self-provision)
  metadata       String?
  /// PN-021 (شورا-ن۰۲۵): VISIBLE (پیش‌فرض) | HIDDEN — کارشناس پنهانِ مالک:
  /// در هیچ فهرست/آمار کاربریِ غیر از تب مخصوص مالک ظاهر نمی‌شود؛
  /// ورود و مجوزها عادی کار می‌کنند (قابلیت مشابه «مدیر پنهان» تلگرام).
  visibility     String    @default("VISIBLE")

  permissions UserPermission[]
  activityLog UserActivity[]
  sessions    UserSession[]
}

/// PN-016 — مجوزهای دقیق هر کاربر روی هر کاشی (ماتریس کاشی × عملیات).
/// OWNER از این جدول عبور می‌کند (دسترسی کامل، بدون محدودیت — بند ۵.۲.۲).
model UserPermission {
  id        String  @id @default(cuid())
  userId    String
  /// شناسهٔ کاشی از MANAGEABLE_TILES (مثال: arm-listings)
  tileId    String
  canRead   Boolean @default(false)
  canWrite  Boolean @default(false)
  canDelete Boolean @default(false)
  canExport Boolean @default(false)
  canSync   Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tileId])
}

/// PN-016 — سیاههٔ فعالیت هر کاربر (مکمل AuditLog امنیتی؛ این‌جا کاربر-محور است).
/// action: login | logout | view | edit | delete | export | sync | role-change | permission-change
model UserActivity {
  id         String   @id @default(cuid())
  userId     String
  action     String
  tileId     String?
  /// شناسهٔ منبع (مثال: کد آگهی/درخواست/نشست)
  resourceId String?
  details    String?
  ip         String?
  userAgent  String?
  timestamp  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([action, timestamp])
}

/// PN-016 — نقشهٔ نشست‌های هر کاربر (برای UI بستن از راه دور).
/// توکن خام هرگز ذخیره نمی‌شود — tokenHash عین Session اصلی (SHA-256).
/// بستن از راه دور = revoke در Session اصلی + isActive=false این‌جا.
model UserSession {
  id             String   @id @default(cuid())
  userId         String
  /// هش توکن نشست = همان tokenHash جدول Session (پیوند منطقی)
  tokenHash      String   @unique
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  lastActivityAt DateTime @default(now())
  isActive       Boolean  @default(true)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

/// PN-018 (فاز ۷ — شورا-ن۰۲۲) — رجیستری نسخه‌های مدل: Champion/Challenger.
/// هر مدل دامنه‌ای چند نسخه دارد؛ در هر لحظه حداکثر یک champion.
/// ارتقا (promote) و بازگشت (rollback) فقط با تأیید شورا (سند ۰۲۷ §۲.۴).
model ModelVersion {
  id              String    @id @default(cuid())
  /// شناسهٔ پایدار مدل (مثل melka-property-v3 — از رجیستری مدل‌ها)
  modelId         String
  /// شمارهٔ نسخه — یکتا در دامنهٔ مدل
  version         Int
  /// champion | challenger | retired | rejected (اعتبارسنجی سطح-اپ)
  status          String    @default("challenger")
  /// امتیاز Brier ارزیابی سایه (null = هنوز ارزیابی نشده)
  brierScore      Float?
  /// نمونه‌های ارزیابی‌شده (پیش‌شرط §۲.۴: ≥۵۰)
  sampleSize      Int       @default(0)
  /// طول پنجرهٔ ارزیابی به روز (پیش‌شرط §۲.۴: ≥۷)
  windowDays      Int       @default(0)
  /// وزن‌های آموخته — عین خروجی LearningEngine (فقط اعداد)
  weightsJson     String?
  /// آیا Brier از نقشهٔ کالیبراسیون مصوب گذشته است؟
  calibrated      Boolean   @default(false)
  /// دروازهٔ شورا — ارتقای بدون تأیید ممنوع (قید مطلق)
  councilApproved Boolean   @default(false)
  /// منبع تأیید (شماره سند/جلسهٔ شورا)
  approvalSource  String?
  promotedAt      DateTime?
  retiredAt       DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([modelId, version])
  @@index([modelId, status])
}

/// PN-018 (فاز ۷) — تاریخ آشکارسازی رانش سه‌گانه (داده/مفهوم/عملکرد).
/// append-only: هر اجرای ۶ساعتهٔ Worker حداکثر سه ردیف تازه — تاریخ روند حفظ می‌شود.
model DriftCheck {
  id            String   @id @default(cuid())
  modelId       String
  /// performance | data | concept
  driftType     String
  /// ۰..۱
  magnitude     Float
  /// monitor | alert | retrain | escalate
  action        String
  rationale     String
  pairsBaseline Int      @default(0)
  pairsRecent   Int      @default(0)
  /// زنجیرهٔ شاهد عین موتور
  evidenceJson  String?
  checkedAt     DateTime @default(now())

  @@index([modelId, checkedAt])
}

/// P6.5-12 — رجیستری کارگزاری‌های صادره (special-properties سامانه ARM).
/// هر «کارگزاری» = قرارداد نمایندگی میان مشاور و مالک برای یک ملک؛
/// فایل PDF آن در خود سامانه ARM هم «تولیدی از همین داده» است (چاپ کارگزاری صادر شده).
model SpecialPropertyRecord {
  id           String    @id
  /// مشاورِ کارگزاری — JSON {id, fullName}
  realtorId    String?
  realtorName  String?
  /// ثبت‌کننده — JSON {id, fullName}
  creatorId    String?
  creatorName  String?
  /// درصد حق‌الزحمه توافق‌شده
  payPercent   Float?
  /// قیمت توافقی مبنای درصد
  sellPrice    Float?
  /// بندهای کارگزاری — HTML عین منبع
  detailsJson  String?
  /// ملک مرتبط — شناسه ARM (از special-properties/info)
  propertyId   String?
  propertyCode String?
  /// کل ردیف خام info عین منبع (قانون دادهٔ مقدس)
  rawJson      String?
  syncedAt     DateTime  @default(now())
  createdAt    DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([propertyId])
  @@index([realtorId])
  @@index([propertyCode])
}

// ===================== لایه ایجنت هوشمند (فقط افزودنی / Append-only) =====================

/// رکورد درخواست ملک — عین ساختار ۴ گامی فرم ثبت درخواست سامانه ARM (new-request-page)
/// گام‌ها: ۱. اطلاعات مشتری ۲. اطلاعات مکانی درخواست ۳. جزییات درخواست ۴. اطلاعات تکمیلی درخواست
model RequestRecord {
  id     String @id @default(cuid())
  /// manual — ثبت دستی (مالک حضوری) | auto — ثبت اتوماتیک (فرم پرشونده ← ثبت مستقیم در آرم)
  source String @default("manual")

  // ---------- گام ۱: اطلاعات مشتری (عین owner-info-step سامانه) ----------
  /// نام و نام خانوادگی درخواست‌دهنده (مشتری)
  customerName   String?
  /// شماره موبایل مشتری (۱۱ رقم با ۰۹ — عین فرم آرم)
  customerMobile String?
  /// شناسه کاربر آرم (پس از جستجو/ایجاد در فرآیند ثبت در سامانه)
  armCustomerId  String?

  // ---------- گام ۲: اطلاعات مکانی درخواست ----------
  /// کشور/استان/شهر — پیش‌فرض ایران/آذربایجان شرقی/تبریز (عین خود سامانه)
  countryId     String?
  stateId       String?
  cityId        String?
  /// مناطق منتخب — JSON آرایه شناسه‌های منطقه آرم
  areaIdsJson   String?
  areaNamesJson String?
  /// محله‌های منتخب — JSON آرایه شناسه‌های محله آرم
  lineIdsJson   String?
  lineNamesJson String?

  // ---------- گام ۳: جزییات درخواست ----------
  /// نوع معامله (برچسب درخواستی: خرید/پیش خرید/رهن و اجاره — nameRequest خود سامانه)
  tradeTypeId         String?
  tradeTypeName       String?
  /// نوع کاربری
  buildingTypeId      String?
  buildingTypeName    String?
  /// نوع ملک
  propertyTypeId      String?
  propertyTypeName    String?
  /// فرم پویای دسته‌بندی — JSON {createName: value} (متراژ از/تا، قیمت کل از/تا، امکانات…)
  inputsJson          String?
  /// P6530/گام ۲ — بازهٔ قیمت متقاضی (تومان) از جزئیات ARM (ستون فهرست M2)
  priceFrom           Float?
  /// P6530/گام ۲ — سقف قیمت متقاضی (تومان) از جزئیات ARM (ستون فهرست M2)
  priceTo             Float?
  /// توضیحات مشتری (عین خود سامانه)
  customerDescription String?

  // ---------- گام ۴: اطلاعات تکمیلی درخواست ----------
  /// نحوه پرداخت مشتری (پول مشتری — user-payment-methods خود سامانه)
  userPaymentMethod     String?
  userPaymentMethodName String?
  /// جدیت مشتری (user-seriousness خود سامانه)
  userSeriousity        String?
  userSeriousityName    String?
  /// P6547/گام دوم — فوریت درخواست (urgent خود ردیف فهرست ARM)
  urgent                Boolean?
  /// P6547/گام دوم — درخواست لوکس (luxury خود ردیف فهرست ARM)
  luxury                Boolean?
  /// P6547/گام دوم — قابل معاوضه (changeable خود ردیف فهرست ARM)
  changeable            Boolean?
  /// توضیحات مشاور
  realtorDescription    String?

  /// چرخه عمر: draft (در تکمیل) | ready (کامل)
  status String @default("draft")

  /// نتیجه ثبت در سامانه ARM — JSON {steps:[{key,title,status,detail}], at}
  armRegistrationJson String?
  armRegisteredAt     DateTime?
  /// شناسه درخواست ثبت‌شده در آرم
  armRequestId        String?

  /// کد پرسنلی ثبت‌کننده
  actorCode String
  /// P6.5-10 — نام و نام خانوادگی کارشناس ثبت‌کننده عین سامانه ARM
  /// (relatedRealtor ردیف درخواست — برای کاشی «درخواست‌های ملک تبریز»؛ افزودنی)
  actorName String?
  /// P6.5-10 — عنوان درخواست عین سامانه ARM (مثل «خرید زمین یا ملک کلنگی...»)؛ افزودنی
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// رویدادهای درخواست (ثبت رویداد — عین request-events سامانه)
  events RequestEventRecord[]

  /// P6.5-02 (§۵.۳) — شعبه انتساب Scope
  branchId             String?
  /// P6.5-02 (§۱۴ مصوبه شورا) — آماده‌سازی چند-مستأجری — nullable + default، بدون منطق فعال
  tenantId             String?   @default("melk-tabriz")
  /// P6.5-03 (§۱.۲) — کد درخواست ARM — کلید طبیعی رکوردهای Bulk (source='arm')
  requestCode          String?   @unique
  /// P6.5-03 — شناسه آخرین اجرای Bulk که این رکورد را نوشت (محافظت از جاروی sync — §۱.۹)
  sourceRunId          String?
  /// B.3 (P6.5-04-v2) — لایه ۱ حقیقت: نام/موبایل مشتری خام عین منبع
  rawCustomerName      String?
  rawCustomerMobile    String?
  /// P6.5-04-e-v2 — ستون‌های سه‌لایه حقیقت (provenance؛ ARM فعلاً نسخه منتشر نمی‌کند)
  rawSourceVersion     String?
  extractedAt          DateTime?
  extractionBatchId    String?
  normalizationVersion String?

  // ===================== PN-002 گام ۲ — ستون‌های تازه از inputs خود ردیف فهرست ARM =====================
  // (بهینه‌ترین گزینهٔ استخراج: inputs خود requests/list — ۱۰۰٪ پر، صفر API اضافه)
  spaceFrom          Float? // متراژ از (inputs.space_from)
  spaceTo            Float? // متراژ تا (inputs.space_to)
  roomsFrom          Int? // اتاق از (inputs.room_whole_from)
  roomsTo            Int? // اتاق تا (inputs.room_whole_to)
  floorFrom          Int? // طبقه از (inputs.floor_from)
  floorTo            Int? // طبقه تا (inputs.floor_to)
  buildYearFrom      Int? // سال ساخت از — جلالی (inputs.year_from)
  buildYearTo        Int? // سال ساخت تا — جلالی (inputs.year_to)
  sanadNames         String? // سند (inputs.sanad[] → «شش‌دانگ، قولنامه…»)
  constructTypeNames String? // نوع ساخت (inputs.construct_type[] → «مجتمع، برج…»)
  sideNames          String? // جهت (inputs.side[] → «شمال، جنوب…»)
  occasion           Boolean? // فرصت (ocasion)
  deposit            Boolean? // رهنی (deposite)
  confirmSms         Boolean? // تایید پیامکی (confirmSMS)
  notifyMe           Boolean? // اطلاع‌رسانی (notifyMe)
  changeWithNames    String? // معاوضه با (changeWith[] → نام‌های رسمی enum)
  armBranchTitle     String? // کسب‌وکار/شعبهٔ مستقیم ARM (businessId.title)
  countryName        String? // کشور (country.name)
  stateName          String? // استان (state.name)
  cityName           String? // شهر (city.name)
  platform           String? // پلتفرم ثبت (platform)

  // ---------- PN-027 · ۵-پ-۱ — ستون‌های سایهٔ نرمال برای فیلتر متنی سطح-SQL ----------
  /// norm(customerName ?? rawCustomerName) ␟ norm(customerMobile) — فیلتر «نام مشتری»: نام یا موبایل (هم‌ارز JS قدیم)
  customerNameNorm String?
  /// norm(sanadNames) — فیلتر «سند» (پیش‌تر JS روی ۲۵٫۵k ردیف — کند‌ترین گلوگاه: P95 ۲۹۵۵ms)
  sanadNamesNorm   String?
  /// norm(actorName) — فیلتر «کارشناس/مغایر» M2
  actorNameNorm    String?

  @@index([status])
  @@index([source])
  @@index([customerMobile])
  @@index([createdAt])
  @@index([armRegisteredAt])
  // PN-027 · ۵-پ-۱ — ایندکس ستون‌های نرمال (پیشوند/دقیق؛ contains روی سطح SQLite می‌ماند)
  @@index([customerNameNorm])
  @@index([sanadNamesNorm])
  @@index([actorNameNorm])
}

/// رویداد درخواست — «ثبت رویداد» عین خود سامانه (request-events/create):
/// نوع رویداد + تاریخ + ساعت + آگهی مرتبط (کدآگهی) + پیام
model RequestEventRecord {
  id        String        @id @default(cuid())
  requestId String
  request   RequestRecord @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /// نوع رویداد — شناسه و نام (از request-event-types خود سامانه)
  eventTypeId        String
  eventTypeName      String
  /// پرچم‌های نوع رویداد — JSON {needTime,needHour,needMessage,needProperty}
  eventTypeFlagsJson String?

  /// تاریخ رویداد (تاریخ شمسی به‌صورت رشته YYYY/MM/DD)
  date          String?
  /// ساعت رویداد (HH:mm)
  hour          String?
  /// آگهی مرتبط — کدآگهی واردشده و شناسه آرم کشفشده
  propertyCode  String?
  armPropertyId String?
  /// پیام (اختیاری)
  message       String?

  /// نتیجه ثبت در سامانه ARM — JSON
  armSyncJson String?
  armSyncedAt DateTime?
  /// شناسه رویداد ثبت‌شده در آرم
  armEventId  String?

  actorCode String
  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([createdAt])
  @@index([eventTypeId])
}

/// حافظه ساخت‌یافته هر کاشی — هرگز Overwrite نمی‌شود
model AgentMemory {
  id        String   @id @default(cuid())
  tileId    String
  kind      String // INTERACTION | INSIGHT_RENDER | POLICY_CHANGE
  payload   String // JSON
  createdAt DateTime @default(now())

  @@index([tileId, createdAt])
}

/// بازخورد کاربر روی بینش‌های هر کاشی — فقط افزودنی
model AgentFeedback {
  id           String   @id @default(cuid())
  tileId       String
  insightKey   String
  insightTitle String
  rating       Int // +1 مفید | -1 غیرمفید
  comment      String?
  context      String // JSON snapshot
  createdAt    DateTime @default(now())

  @@index([tileId, createdAt])
}

/// نسخه‌های سیاست ایجنت — نسخه قبلی هرگز حذف نمی‌شود (قابلیت Rollback)
model AgentPolicyVersion {
  id          String    @id @default(cuid())
  tileId      String
  version     Int
  content     String // JSON سیاست فعال
  rationale   String // دلیل این نسخه
  active      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  activatedAt DateTime?

  // ---------- P2-06: متادیتای نسخه سیاست (فقط افزودنی — استفاده در PHASE 6/9) ----------
  // اصل: ستون‌های active قدیمی حذف نمی‌شوند — «دو‌راهه» تا PHASE 9.
  // در PHASE 2 فقط ساخته/برگشت داده می‌شوند؛ منطق یادگیری صفر تغییر.
  /// نسخه مدل یادگیری که این سیاست را ساخته (مثل "feedback-weighted-v1")
  modelVersion     String?
  /// نسخه مجموعه ویژگی‌های ورودی (مثل "tf-cosine-v1")
  featureVersion   String?
  /// پنجره داده آموزش (ISO 8601 duration، مثل "P90D")
  trainingWindow   String?
  /// پنجره داده ارزیابی (ISO 8601 duration)
  evaluationWindow String?
  /// سنجه‌های ارزیابی این نسخه (JSON — precision/recall/…)
  metricsJson      String?
  /// کد پرسنلی سازنده
  createdBy        String?
  /// کد پرسنلی تأییدکننده (گردش کار PHASE 9)
  approvedBy       String?
  /// چرخه عمر نسخه: active | retired | draft | archived — دو‌راهه با active
  status           String? @default("active")
  /// هدف بازگشت در صورت لغو این نسخه (نسخه‌ای که باید فعال شود)
  rollbackTarget   Int?

  @@unique([tileId, version])
}

/// P6519 — شاهد زندهٔ بیلد (دستور شورا: رفع دائمی لینک‌های کهنه، الزام app_meta)
/// جدول singleton: آخرین بیلدی که سرور با آن بوت شده را ثبت می‌کند.
/// instrumentation در هر بوت upsert می‌کند؛ صفر رابطه با سایر جداول (قانون حرمت داده — افزودنی خالص).
model AppMeta {
  /// همیشه "singleton" — تنها یک رکورد در کل جدول
  id             String   @id
  /// "<gitSha8>-<yyyymmdd>-<hhmm>" (production) یا "dev-<sha>-<stamp>" (dev)
  buildId        String?
  /// ISO 8601 — زمان build (یا بوت سرور در dev)
  builtAt        String?
  /// ۸ نویسهٔ کامیت گیت
  gitSha         String?
  /// development | production
  env            String?
  /// PN-002 نکته ۱ — هش SHA-256 کد مستر مالک (بقای بازنشانی محیط: DB زنده می‌ماند؛
  /// فقط هش — هرگز خود کد در DB نمی‌نشیند؛ fallback دومِ master-login پس از env)
  masterCodeHash String?
  recordedAt     DateTime @updatedAt
}

/// P6545/گام۱ (BLOCK 1.1) — پایدارسازی وضعیت کار پس‌زمینه در DB (جلسه ۰۳۰ سؤال ۹)
/// پیش از این، پیشرفت کارها فقط در حافظهٔ فرایند بود و با ری‌استارت گم می‌شد.
/// الگوی الزامی جلسه ۰۳۳: jobId, lastCompletedPage, resumedFrom, updatedAt.
model SyncJobState {
  /// شناسهٔ کار — مثل catalog-listings | catalog-requests | catalog-enrich-listings | main-sync
  jobId             String   @id
  /// خانوادهٔ کار: catalog | enrichment | sync
  jobKind           String
  /// idle | running | paused | done | failed
  status            String   @default("idle")
  /// آخرین صفحهٔ کامل-ذخیره‌شده (داده اول، سپس چک‌پوینت)
  lastCompletedPage Int      @default(0)
  /// نقطهٔ ازسرگیری (ادامه — هرگز شروع از صفر)
  resumedFrom       Int      @default(1)
  totalPages        Int      @default(0)
  /// ۰ تا ۱۰۰ — شفافیت UI
  progressPercent   Float    @default(0)
  /// جزئیات آخرین برش (JSON) — شفافیت کامل
  detailJson        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([jobKind, status])
}

/// P6545/گام۱ (BLOCK 1.2) — سه گراف اصلی (جلسه ۰۰۷/۰۲۲/۰۳۰): گراف ملک، افراد، معاملات
/// ذخیرهٔ generic در DB — هر گراف: nodes + edges + traverse + findPath + query.
model GraphNode {
  id        String   @id @default(cuid())
  /// property | people | transaction
  graph     String
  /// property | person | expert | customer | transaction | request | area
  nodeType  String
  /// شناسهٔ طبیعی رکورد مرجع (propertyCode / personnelCode / tx id / mobile / areaId)
  refId     String
  label     String?
  /// ویژگی‌های گره — JSON (آدرس، متراژ، قیمت، نوع، مالک‌ها، آگهی‌ها، معاملات …)
  propsJson String?
  tenantId  String?  @default("melk-tabriz")
  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([graph, nodeType, refId])
  @@index([graph, nodeType])
  @@index([nodeType, refId])
}

/// یال‌های سه گراف — ملک↔مالک · ملک↔آگهی · ملک↔معامله · فرد↔ملک · فرد↔معامله · فرد↔درخواست …
model GraphEdge {
  id        String   @id @default(cuid())
  graph     String
  fromType  String
  fromRef   String
  toType    String
  toRef     String
  /// owned_by | listed_by | located_in | involves_property | bought | sold | brokered_by | requested_for | matches
  edgeType  String
  weight    Float    @default(1)
  propsJson String?
  createdAt DateTime @default(now())

  @@unique([graph, fromType, fromRef, toType, toRef, edgeType])
  @@index([graph, edgeType])
  @@index([fromType, fromRef])
  @@index([toType, toRef])
}

/// P6545/گام۱ (BLOCK 1.4) — هشدار فرصت: تطبیق آگهی↔درخواست (جلسه ۰۳۰ سؤال ۱۰)
/// قید مطلق: صفر اجرای خودکار — فقط هشدار.
model OpportunityAlert {
  id           String    @id @default(cuid())
  /// listing_to_request | request_to_listing
  direction    String
  /// کدآگهی (PropertyRecord.propertyCode)
  listingCode  String?
  /// شناسهٔ درخواست (RequestRecord.id)
  requestId    String?
  /// امتیاز تطبیق (۰ تا ۱) — آستانهٔ انتشار: ≥ ۰٫۷
  matchScore   Float
  /// دلایل تطبیق — JSON [{factor, value, weight}]
  matchReasons String
  /// new | seen | dismissed
  status       String    @default("new")
  emittedAt    DateTime  @default(now())
  seenAt       DateTime?

  @@index([direction, status])
  @@index([listingCode])
  @@index([requestId])
}

/// PN-010 (BLOCK 2) — قفل کار توزیع‌شده با ضربان قلب:
/// جلوگیری از اجرای تکراری یک کار وقتی چند نمونه از Worker/سرور زنده‌اند.
/// acquire → heartbeat (۳۰ ثانیه) → release / انقضا خودکار (cleanup).
model JobLock {
  jobId         String   @id
  /// شناسهٔ نمونهٔ دارندهٔ قفل (مثلاً worker:<pid>:<boot-id>)
  instanceId    String
  acquiredAt    DateTime @default(now())
  lastHeartbeat DateTime @default(now())
  /// زمان انقضا — قفل منقضی = متروکه؛ قابل تصرف توسط نمونهٔ دیگر
  expiresAt     DateTime
  /// JSON آزاد (pid، وضعیت کار، …) — هرگز راز
  metadata      String?

  @@index([expiresAt])
}

/// PN-019 فاز ۸ — رکورد تصمیم پایدار (۱۵ فیلد پندرگانه + قید autoExecute=false در سطح DB)
/// دکترین: append-mostly — فقط تغییر وضعیت (active→expired→superseded)؛ حذف فیزیکی ممنوع.
model DecisionRecord {
  id                    String   @id @default(cuid())
  /// ارجاع به پیش‌بینی مبدأ (SAF-001: صفر تصمیم بدون پیش‌بینی)
  predictionId          String
  /// wait | investigate | contact_owner | assign_expert | adjust_price | schedule_visit | priority_action
  decisionType          String
  /// کنش پیشنهادی نخست (فارسی)
  proposedAction        String
  /// اطمینان ۰..۱ (SAF-002: ≥۰٫۳)
  confidence            Float
  /// دلیل کامل فارسی (SAF-003)
  rationale             String
  /// اثر کمی سه‌مؤلفه‌ای {liftPercent, reach, horizonDays, basis} — §۸ سند طراحی
  expectedImpact        String
  /// ≥۳ گزینهٔ رتبه‌بندی‌شده [{action, whyRejected, expectedValue, rank}] — §۹
  alternativesJson      String
  /// فهرست منابع لازم
  requiredResourcesJson String
  /// گزارش هفت‌قاعده‌ای SAF عین SafetyReport موتور
  safetyReportJson      String
  /// active | expired | superseded
  status                String   @default("active")
  /// انقضای تصمیم (پیش‌فرض ۷ روز — §۱۰)
  expiresAt             DateTime
  createdAt             DateTime @default(now())
  /// Tier لحظهٔ ساخت
  tierAtCreation        Int      @default(0)
  /// مهر نسخهٔ قهرمان لحظهٔ تصمیم (قابلیت ردیابی)
  modelVersionId        String?
  /// قید سازندهٔ فاز ۸ — همیشه true
  requiresApproval      Boolean  @default(true)
  /// قید سازندهٔ فاز ۸ — همیشه false (GOV-DECISION-001)
  autoExecute           Boolean  @default(false)

  @@index([status, expiresAt])
  @@index([predictionId])
  @@index([createdAt])
}

/// PN-019 فاز ۸ — برنامهٔ اقدام پایدار (rollback برای هر ۵ الگو — §۱۱)
model ActionPlanRecord {
  id                       String   @id @default(cuid())
  decisionId               String
  /// direct_call | property_visit | price_adjust | expert_assign | smart_wait
  pattern                  String
  /// گام‌ها [{order, action, owner, estimatedMinutes, dependencies}]
  stepsJson                String
  /// طرح بازگشت — همیشه غیر-null پس از فاز ۸
  rollbackPlan             String
  /// خروجی simulate() {totalMinutes, criticalPath, bottlenecks}
  simulationJson           String
  /// خروجی estimateImpact() {liftPercent, rationale}
  impactJson               String
  estimatedDurationMinutes Int
  /// low | medium | high
  riskLevel                String
  /// قید مطلق — همیشه false
  autoExecute              Boolean  @default(false)
  createdAt                DateTime @default(now())

  @@index([decisionId])
  @@index([createdAt])
}

/// PN-019 فاز ۸ — شاهد پایدار هر بررسی ایمنی (SAF-006: تغییر داده بدون audit ممنوع)
model SafetyCheckRecord {
  id               String   @id @default(cuid())
  decisionId       String
  passed           Boolean
  blockedByJson    String
  warningsJson     String
  checkedRulesJson String
  checkedAt        DateTime @default(now())

  @@index([decisionId])
  @@index([checkedAt])
}

/// PN-019 فاز ۸ — جریان سایه: تصمیم فقط ثبت، صفر اجرا (executedSteps همیشه ۰ — §۱۴)
model ShadowDecisionRun {
  id                 String   @id @default(cuid())
  /// predictionId مبدأ
  sourcePredictionId String
  decisionId         String
  /// قید لفظی — صفر گام اجراشده
  executedSteps      Int      @default(0)
  /// ثبت شد | ایمنی بلاک کرد | خطا
  verdict            String
  ranAt              DateTime @default(now())

  @@index([ranAt])
  @@index([decisionId])
}

/// PN-019 فاز ۹ — تاریخچهٔ بررسی ۱۵قاعده‌ای حاکمیت (append-only — سابقهٔ تغییرناپذیر)
model GovernanceCheckRecord {
  id                     String   @id @default(cuid())
  passed                 Int
  failed                 Int
  /// critical نقض‌شده (ruleIdها)
  criticalViolationsJson String
  /// آرایهٔ ۱۵تایی [{ruleId, passed, severity, details}]
  resultsJson            String
  /// زمینهٔ ۱۷فیلدی زنده که بررسی رویش اجرا شد (شاهد ممیزی)
  contextJson            String
  /// strict | audit-only | disabled
  enforcement            String
  /// worker | manual
  triggerSource          String
  checkedAt              DateTime @default(now())

  @@index([checkedAt])
}

/// PN-019 فاز ۹ — ارزیابی دوره‌ای سیاست‌ها (هر ۹۰ روز — §۱۲)
model PolicyEvaluationRecord {
  id               String   @id @default(cuid())
  policyId         String
  /// learning | safety | governance | access
  policyType       String
  windowFrom       DateTime
  windowTo         DateTime
  /// ۴ متریک {effectiveness, stability, compliance, costImpact}
  metricsJson      String
  /// keep | adjust | retire
  verdict          String
  rationale        String
  /// شمارش رویدادها/بازرسی‌ها + insufficientData
  evidenceJson     String
  tierAtEvaluation Int      @default(0)
  evaluatedAt      DateTime @default(now())

  @@index([policyId, evaluatedAt])
  @@index([evaluatedAt])
}

/// ═══ PN-020 · فاز ۱۰ — گزارش تشخیص خودآگاهی (۲۵ بررسی · نمرهٔ سلامت ۰-۱۰۰) ═══
model DiagnosticReport {
  id            String   @id @default(cuid())
  /// نمرهٔ سلامت کلی ۰-۱۰۰ (میانگین موزون ۲۵ بررسی)
  healthScore   Int
  /// تعداد بررسی‌های پاس‌شده از ۲۵
  passedCount   Int
  /// هشدارهای فعال [{checkId, severity, message}]
  alertsJson    String
  /// آرایهٔ ۲۵تایی [{checkId, category, title, passed, weight, value, expected, message}]
  checksJson    String
  /// worker | manual
  triggerSource String
  /// مدت اجرای کل چرخه (ms)
  durationMs    Int
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

/// ═══ PN-020 · فاز ۱۱ — پیشنهاد ترمیم خودکار (با دروازهٔ تأیید شورا) ═══
model RepairProposalRecord {
  id               String    @id @default(cuid())
  /// شناسهٔ بررسیِ برمی‌گرداندندهٔ پیشنهاد از DiagnosticReport
  checkId          String
  /// یکی از هفت کنش: reindex | recalibrate | retrain | prune_sessions | restore_backup | update_threshold | custom
  actionType       String
  /// هدف ترمیم (نام مدل/جدول/تنظیم)
  target           String
  justification    String
  expectedOutcome  String
  /// طرح بازگشت اجباری (قید فاز ۱۱)
  rollbackPlan     String
  /// proposed | approved | rejected | executed | failed | rolled_back
  status           String
  /// شورا | مالک — منبع تأیید (صفر ترمیم بدون تأیید)
  approvalSource   String?
  approvedAt       DateTime?
  executedAt       DateTime?
  /// نتیجهٔ اجرا + شواهد
  resultJson       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// PN-023-A (فاز ۱۳-الف) — یال گراف علّی پایدار (موتور ۱۳).
/// افزودنی صرف (قانون ۸): صفر DROP · صفر DELETE · صفر تغییر ستون موجود.
/// گارانتی‌ها: کف اطمینان ۰٫۶ (گارد audit-causal-validity) · DAG پیش از ذخیره
/// (assertDag در causal-graph-store) · upsert idempotent بر کلید یکتا.
model CausalEdgeRecord {
  id          String   @id @default(cuid())
  fromFeature String
  toFeature   String
  /// −1..+1 — جهت و اندازهٔ اثر (مدل خطی SCM)
  coefficient Float
  /// 0..1 — کف پذیرش ۰٫۶
  confidence  Float
  /// L1 | L2 — سطح Pearl مولد یال
  method      String
  /// شاهد فارسی (n، r، نحوهٔ محاسبه)
  evidence    String
  createdAt   DateTime @default(now())

  @@unique([fromFeature, toFeature, method])
  @@index([toFeature])
}

/// ═══ PN-025 (فاز ۱۳-ج / ستون ۱) — حافظهٔ بلندمدت: سه جدول تازه ═══
/// افزودنی صرف (قانون ۸): صفر DROP · صفر DELETE · صفر تغییر ستون موجود.
/// سطح‌بندی عصب‌شناختی: داغ (هفته) · گرم (ماه) · سرد (آرشیو) + تثبیت شبانه (خواب).
model MemoryLifecycle {
  id              String   @id @default(cuid())
  /// hot | warm | cold — سطح حافظه
  category        String
  /// شناسهٔ بستر — کد ملک / نرمال‌شدهٔ شخص / شناسهٔ توصیه …
  itemId          String
  /// property | person | request | transaction | advice | insight
  itemType        String
  lastAccessedAt  DateTime @default(now())
  accessCount     Int      @default(0)
  /// 0..1 — فرمول فصل ۳.۳ سند طراحی (تازگی ۰٫۴ + بسامد ۰٫۳۵ + پیوند نتیجه ۰٫۲۵)
  importanceScore Float    @default(0)
  /// زنجیرهٔ تبار برای audit پس از گذار سطح (رکورد حذف نمی‌شود — دادهٔ مقدس)
  consolidatedTo  String?
  createdAt       DateTime @default(now())

  @@unique([itemType, itemId])
  @@index([category, lastAccessedAt])
  @@index([importanceScore])
}

/// هر اجرای تثبیت شبانه — شاهد کامل + بازتولیدپذیری (آستانه‌ها در evidence)
model ConsolidationRun {
  id         String   @id @default(cuid())
  ranAt      DateTime @default(now())
  /// شمار ارتقای hot→warm (عمر>۷روز و امتیاز≥۰٫۷)
  hotToWarm  Int      @default(0)
  /// شمار تنزل warm→cold (عمر>۳۰روز و امتیاز<۰٫۳)
  warmToCold Int      @default(0)
  /// شمار بیداری cold→warm (دسترسی تازه + جهش امتیاز) — آرشیو حذف نیست
  archived   Int      @default(0)
  /// مدت اجرا (ms)
  duration   Int      @default(0)
  /// { before:{hot,warm,cold}, after:{...}, topPromoted:[...] }
  summary    Json?
  /// { thresholds:{promote:0.7,demote:0.3,hotDays:7,warmDays:30}, sampled:[...] }
  evidence   Json?

  @@index([ranAt])
}

/// سیاست نگهداری هر سطح — قابل تنظیم بدون استقرار تازه (ستون compression برای فشرده‌سازی آینده)
model RetentionPolicy {
  id            String    @id @default(cuid())
  /// hot | warm | cold
  category      String
  retentionDays Int
  /// none | gzip-json (فعلاً none — مسیر رشد فصل ۱۰)
  compression   String?
  nextReviewAt  DateTime?
  appliedBy     String?

  @@unique([category])
}

/// PN-028/رابعاً-ج — درس‌های رد تطبیق (دستور مالک: مغز ملکا از دلایل واقعی رد بیاموزد
/// و در پیشنهادهای تطبیقِ آینده همان اشتباه را تکرار نکند).
/// هر رد = یک جفت (آگهی × درخواست) + دلایل ساختاریافته + یادداشت آزاد.
/// یادگیری سه‌لایه: (۱) همین جفت هرگز دوباره پیشنهاد نمی‌شود (۲) دلایل پرتکرار
/// وزن عامل متناظر را در امتیازدهی تطبیق‌های آینده تقویت می‌کنند (۳) حلقهٔ
/// بازخورد ایجنت (AgentFeedback) همان رد را برای وزن‌های آموخته ثبت می‌کند.
model MatchRejectionRecord {
  id          String   @id @default(cuid())
  /// listing_to_request | request_to_listing
  direction   String
  /// کد آگهی سمت تطبیق
  listingCode String?
  /// کد درخواست سمت تطبیق
  requestCode String?
  /// کلیدهای دلایل رد — ["price","geo","meterage","type","rooms","floor","age","stale","dealt","customer","other"]
  reasonsJson String
  /// دلیل آزاد کاربر (گزینهٔ «سایر» یا توضیح تکمیلی)
  note        String?
  /// امتیاز تطبیق در لحظهٔ رد (شاهد بازتولیدپذیری)
  scoreAtReject Float?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([listingCode])
  @@index([requestCode])
}

/// PN-029/مرحلهٔ ۶ (شورا-ن۰۳۳) — وضعیت فیوز قطع‌کنندهٔ هر میزبان خارجی.
/// قانون Retry هوشمند: ۱ تلاش در ۶ ساعت · backoff پله‌ای ۶/۱۲/۲۴ ساعت ·
/// ۳ شکست پیاپی = قفل سخت ۲۴ ساعته. شکست = فقط خطاهای سمت سرور/شبکه/نرخ.
model CircuitBreakerState {
  id                  String    @id @default(cuid())
  /// میزبان هدف (مثلاً arus-api.melketabriz.ir)
  target              String    @unique
  /// شمار شکستهای پیاپی از آخرین موفقیت
  consecutiveFailures Int       @default(0)
  /// آمار تجمعی (شکست)
  totalFailures       Int       @default(0)
  /// آمار تجمعی (موفقیت)
  totalSuccesses      Int       @default(0)
  lastFailureAt       DateTime?
  lastSuccessAt       DateTime?
  /// تا این زمان تلاش بعدی مجاز نیست (backoff)
  nextAttemptAt       DateTime?
  /// قفل سخت پس از ۳ شکست پیاپی — ۲۴ ساعت
  lockUntil           DateTime?
  updatedAt           DateTime  @updatedAt

  @@index([nextAttemptAt])
  @@index([lockUntil])
}

/// PN-029/مرحلهٔ ۷ (شورا-ن۰۳۳) — تاریخچهٔ IP عمومی کانتینر.
/// هر ۶ ساعت (کار Worker) و در هر بوت ثبت می‌شود؛ تغییر IP پس از ریست
/// پلتفرم = سرنخ ریشهٔ «الف» (بلاک‌لیست IP در ملک تبریز).
model ContainerIpLog {
  id         String   @id @default(cuid())
  ip         String
  /// منبع تشخیص (ifconfig.me / api.ipify.org)
  source     String   @default("ifconfig.me")
  /// آیا نسبت به نمونهٔ قبلی تغییر کرده بود؟
  changed    Boolean  @default(false)
  detectedAt DateTime @default(now())

  @@index([detectedAt])
  @@index([ip])
}

/// PN-034 (شورا-ن۰۵۵ · قانون مالک: صفر محدودیت اتصال · ۱۴۰۵/۰۷/۲۶):
/// مدل OtpRateLimit (مکانیزم OTP تک‌بارة PN-029 — قفل ۶ ساعته) برای همیشه
/// حذف شد. درس ۰۵۵: «پاکسازی بیش از حد، به اندازهٔ ناکافی بد است» — اما
/// قفلِ ماندرده روی مسیر مالک بدتر است. هیچ محدودیت اتصالی بازنمی‌گردد.

/// PN-031 (شورا-ن۰۳۷ · ۱۴۰۵/۰۷/۲۲) — دستگاه‌های رلهٔ موبایل ایرانی.
/// هر دستگاه (Termux روی گوشی مالک) با deviceId + secret اختصاصی که فقط
/// مالک می‌تواند از تنظیمات (OWNER) ثبتش کند؛ قابل ابطال در هر لحظه.
model RelayDevice {
  id            String    @id @default(cuid())
  /// شناسهٔ عمومی دستگاه (مثلاً poco-f3-7f3a) — در هر درخواست poll/result
  deviceId      String    @unique
  /// راز HMAC دستگاه (۶۴ هگز) — همان قرارداد امضای PN-030
  secret        String
  /// برچسب انسانی (مثلاً «Poco F3 سیدی»)
  label         String    @default("")
  /// کد یک‌بارمصرف راه‌اندازی — پس از دانلود اسکریپت خالی می‌شود
  enrollCode    String?
  enrollExpires DateTime?
  /// PN-031-C (شورا-ن۰۴۰) — کد بخشنده: شمارش تلاش‌های دانلود bootstrap.
  /// سوختن نهایی (enrolledAt + خنثی‌سازی کد) فقط پس از اولین Poll موفق گوشی؛
  /// تلاش ناموفق (شبکه/کانتینر/هر علت) کد را نمی‌سوزاند — تا ۳ تلاش در پنجرهٔ ۳۰دقیقه.
  attemptCount  Int       @default(0)
  /// سقف تلاش per device (پیش‌فرض ۳ — مصوب جلسهٔ ۰۴۰)
  maxAttempts   Int       @default(3)
  /// آخرین تلاش دانلود bootstrap (حالت «در حال نصب»)
  lastAttemptAt DateTime?
  enrolledBy    String    @default("")
  enrolledAt    DateTime?
  lastSeenAt    DateTime?
  lastIp        String?
  revokedAt     DateTime?
  /// شمارنده‌های بدون محتوا (قانون «صفر لاگ محتوا» شورا)
  servedCount   Int       @default(0)
  errorCount    Int       @default(0)
  lastRoundtripMs Int?

  @@index([deviceId, lastSeenAt])
}

/// PN-031 (شورا-ن۰۳۷ · ۱۴۰۵/۰۷/۲۲) — صف درخواست‌های عبوری از رلهٔ موبایل.
/// armCall → enqueue (pending) → گوشی poll می‌گیرد (dispatched) → نتیجه
/// برمی‌گردد (done/failed) یا منقضی می‌شود (expired — TTL ۴۵ ثانیه).
model RelayQueue {
  id          String    @id @default(cuid())
  /// روش HTTP مقصد (GET/POST/…)
  method      String
  /// نشانی کامل مقصد — فقط میزبانهای whitelist ملک تبریز (عین proxy.ts)
  url         String
  /// هدرهای عبوری مجاز (authorization/content-type/accept) — JSON
  headersJson String?
  /// بدنهٔ درخواست (متنی — همان قرارداد proxyFetch)
  body        String?
  /// pending | dispatched | done | failed | expired
  status      String    @default("pending")
  fingerprint String
  enqueuedAt  DateTime  @default(now())
  dispatchedAt DateTime?
  completedAt DateTime?
  /// deviceId دستگاهی که این درخواست را برداشته/اجرا کرده
  claimedBy   String?
  /// ── نتیجه (فقط پس از done/failed) ──
  responseStatus   Int?
  responseContentType String?
  responseBody      String?
  /// خطای شبکه/اجرا سمت گوشی (بدون محتوا — فقط پیام خطا)
  error       String?
  /// منبع ثبت: armCall (تولید واقعی) | gate-test (تست دروازهٔ مالک)
  source      String    @default("armCall")

  @@index([status, enqueuedAt])
  @@index([fingerprint, enqueuedAt])
  @@index([claimedBy, dispatchedAt])
}
