// Prisma schema — داشبورد هوشمند چندعامله ملک تبریز
// Owner/Designer/Developer: سید نعمت اله سیدی

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===================== امنیت و احراز هویت =====================

/// نشست‌های کاربری — توکن به‌صورت هش‌شده ذخیره می‌شود (هرگز متن ساده)
/// توکن‌های ARM (دریافت‌شده از سامانه واقعی ملک تبریز) رمزنگاری‌شده AES-256-GCM نگهداری می‌شوند
model Session {
  id                 String   @id @default(cuid())
  tokenHash          String   @unique
  personnelCode      String
  displayName        String
  role               String   @default("CONSULTANT") // OWNER | CONSULTANT
  /// توکن دسترسی ARM — رمزنگاری‌شده (اختیاری؛ ورود مدیر محلی ندارد)
  armTokenEnc        String?
  /// توکن تمدید ARM — رمزنگاری‌شده
  armRefreshTokenEnc String?
  /// نوع کاربر در سامانه ARM (مثلاً realtor)
  armUserType        String?
  createdAt          DateTime @default(now())
  expiresAt          DateTime
  lastSeenAt         DateTime @default(now())
  revoked            Boolean  @default(false)
  revokedReason      String?
  userAgent          String?
  ip                 String?
}

/// ثبت تلاش‌های احراز هویت برای محدودسازی نرخ (Rate Limiting)
model OtpAttempt {
  id            String   @id @default(cuid())
  personnelCode String
  kind          String // REQUEST_OTP | VERIFY_OTP | MASTER_LOGIN
  success       Boolean  @default(false)
  createdAt     DateTime @default(now())
  ip            String?

  @@index([personnelCode, kind, createdAt])
}

/// رد حسابرسی امنیتی
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actor     String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ===================== داده‌های CRM (کش/همگام‌سازی) =====================

/// وضعیت همگام‌سازی با سامانه‌های واقعی ملک تبریز (تک‌رکورد)
model SyncState {
  id             String    @id // "singleton"
  lastSyncedAt   DateTime?
  lastSuccessAt  DateTime?
  lastError      String?
  lastErrorCode  String?
  attempts       Int       @default(0)
  /// توکن ARM رمزنگاری‌شده آخرین همگام‌سازی موفق (برای تلاش مجدد پس‌زمینه)
  armTokenEnc    String?
  updatedAt      DateTime  @updatedAt
}

/// معاملات — از سامانه واقعی ملک تبریز استخراج و کش می‌شود
model TransactionRecord {
  id           String   @id
  dealDate     DateTime
  listingCode  String // کد آگهی
  requestCode  String? // کد درخواست خرید
  expertCode   String // کد پرسنلی کارشناس معامله‌گر
  expertName   String
  price        Float // مبلغ معامله (تومان)
  district     String // محله
  propertyType String // نوع ملک
  area         Float // متراژ
  commission   Float // کمیسیون (تومان)
  syncedAt     DateTime @default(now())

  @@index([dealDate])
  @@index([expertCode])
  @@index([listingCode])
}

/// کارشناسان — از سامانه ملک تبریز استخراج و کش می‌شود
model ExpertRecord {
  id            String   @id
  personnelCode String   @unique
  fullName      String
  mobile        String
  address       String
  branch        String
  active        Boolean  @default(true)
  joinedAt      DateTime
  syncedAt      DateTime @default(now())

  @@index([fullName])
}

// ===================== لایه ایجنت هوشمند (فقط افزودنی / Append-only) =====================

/// حافظه ساخت‌یافته هر کاشی — هرگز Overwrite نمی‌شود
model AgentMemory {
  id            String   @id @default(cuid())
  tileId        String
  kind          String // INTERACTION | INSIGHT_RENDER | POLICY_CHANGE
  payload       String // JSON
  createdAt     DateTime @default(now())

  @@index([tileId, createdAt])
}

/// بازخورد کاربر روی بینش‌های هر کاشی — فقط افزودنی
model AgentFeedback {
  id         String   @id @default(cuid())
  tileId     String
  insightKey String
  insightTitle String
  rating     Int // +1 مفید | -1 غیرمفید
  comment    String?
  context    String // JSON snapshot
  createdAt  DateTime @default(now())

  @@index([tileId, createdAt])
}

/// نسخه‌های سیاست ایجنت — نسخه قبلی هرگز حذف نمی‌شود (قابلیت Rollback)
model AgentPolicyVersion {
  id          String   @id @default(cuid())
  tileId      String
  version     Int
  content     String // JSON سیاست فعال
  rationale   String // دلیل این نسخه
  active      Boolean  @default(false)
  createdAt   DateTime @default(now())
  activatedAt DateTime?

  @@unique([tileId, version])
}
