/deliver-store/
db/postgres-test/

# PN-031 — بکاپهای پیش-اجرا در db/ (قانون: داده در upload/، نه در git)
db/pre-*.db
db/custom.db.pre-pn041r-*
db/custom.db-journal
db/custom.db.broken-*

# PN-043 (شورا-ن۰۸۷): evidence dir — db backups & runtime logs stay out of git
download/pn043/*.db
server.log.*.gz
.next.backup-*/
download/pn044/*.db
/download/*/pre-*.db
/download/*/*.db

# PN-052: دیتابیس کهنه‌شدهٔ رستاخیز (زندهٔ جایگزین‌شده — هرگز وارد گیت نمی‌شود)
