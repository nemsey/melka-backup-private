# متغیرهای محیطی — داشبورد هوشمند ملک تبریز
# این فایل را به .env کپی و مقدارها را تنظیم کنید.

# آدرس فرانت سامانه‌های ملک تبریز (اطلاعاتی)
MELK_ARM_FRONT_URL=https://arm.melketabriz.ir
MELK_PM_FRONT_URL=https://pm.melketabriz.ir

# ✅ آدرس‌های API واقعی (کشف‌شده از خود سامانه‌ها — بدون تغییر کار می‌کنند)
MELK_ARM_API_BASE=https://arus-api.melketabriz.ir/api/apm/
MELK_ARM_PUBLIC_API_BASE=https://arus-api.melketabriz.ir/api/public/
MELK_PM_API_BASE=https://pm-api.melketabriz.ir/api/

# مهلت پاسخ و تلاش مجدد (سرورهای میزبانی ایرانی گاهی کندند)
MELK_API_TIMEOUT_MS=25000
MELK_API_MAX_RETRIES=2

# فاصله همگام‌سازی خودکار داده واقعی (دقیقه)
MELK_SYNC_INTERVAL_MINUTES=5

# کلید رمزنگاری توکن‌های ARM (AES-256-GCM) — در استقرار تولید حتماً تغییر دهید
MELK_TOKEN_KEY=change-this-to-a-long-random-secret

# کد ورود مدیر (مالک) — ۸ رقم؛ پیش از استقرار تولید حتماً تغییر دهید
MASTER_ACCESS_CODE=41372895

# عمر نشست (ساعت)
SESSION_TTL_HOURS=12

# پایگاه داده
DATABASE_URL=file:/home/z/my-project/db/custom.db
