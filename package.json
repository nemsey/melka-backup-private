{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "1.7.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/pn006/dev-entry.sh",
    "dev:real": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "RAYON_NUM_THREADS=1 next build --experimental-build-mode compile && RAYON_NUM_THREADS=1 next build --experimental-build-mode generate && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/ && (cp env.platform.json .next/standalone/ 2>/dev/null || true) && rm -rf .next/standalone/backups .next/standalone/db .next/standalone/prisma/db .next/standalone/download .next/standalone/skills .next/standalone/scripts .next/standalone/tool-results .next/standalone/docs .next/standalone/examples .next/standalone/tests .next/standalone/bun.lock .next/standalone/dev.log .next/standalone/server.log .next/standalone/worklog.md .next/standalone/upload/dataset-backups .next/standalone/upload/*.tar.gz .next/standalone/upload/*.md .next/standalone/intelligence-data .next/standalone/deliver-store .next/standalone/public/deliver",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "test": "DATABASE_URL=file:/home/z/my-project/db/test.db MELK_TOKEN_KEY=test-only-key-not-a-real-secret MELK_API_TIMEOUT_MS=300 bun test tests/",
    "test:db:push": "DATABASE_URL=file:/home/z/my-project/db/test.db prisma db push --accept-data-loss",
    "postbuild": "bun run scripts/fingerprint.ts --write-next",
    "postinstall": "prisma generate",
    "ci": "bash scripts/ci.sh",
    "tile:new": "bun scripts/feature-factory/tile-new.ts"
  },
